---
import {
  getSpaceVideosFromDb,
  getStaticBackgroundsFromDb,
} from '../utils/MediaDatabase';

const spaces = await getSpaceVideosFromDb();
const staticBgs = await getStaticBackgroundsFromDb();

const spaceCategories = ["All Spaces", "Trending", "New Spaces", "Cozy Rooms", "Cafes", "Nature & Rain", "City & Travel"];
const bgCategories    = ["All", "Minimal", "Nature", "Aesthetic", "Dark Mode", "Abstract"];
---

<!-- ═══════════════════════════════════════════════════════════
     SPACES & BACKGROUND LIBRARY DRAWER
     Three tabs: Video Spaces | Static Backgrounds | My Uploads
     ═══════════════════════════════════════════════════════════ -->
<div id="spaces-drawer" class="fixed top-0 left-0 h-full w-[400px] max-w-[92vw] z-[110] glass -translate-x-full transition-transform duration-300 ease-out flex flex-col edge-highlight">

  <!-- ── Header ─────────────────────────────────────── -->
  <div class="flex items-center justify-between p-5 border-b border-hairline shrink-0">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span class="font-sans font-semibold text-lg tracking-tight">Background Library</span>
    </div>
    <button id="close-drawer" class="text-ink-subtle hover:text-ink hover:bg-surface-2 p-1.5 rounded-md transition cursor-pointer" aria-label="Close background library">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- ── Main Tabs ───────────────────────────────────── -->
  <div class="flex gap-0 px-4 pt-3 border-b border-hairline shrink-0">
    <button id="drawer-tab-spaces" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-primary text-ink cursor-pointer transition" aria-selected="true">
      Video Spaces
    </button>
    <button id="drawer-tab-backgrounds" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-transparent text-ink-subtle hover:text-ink cursor-pointer transition" aria-selected="false">
      Static Backgrounds
    </button>
    <button id="drawer-tab-uploads" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-transparent text-ink-subtle hover:text-ink cursor-pointer transition" aria-selected="false">
      My Uploads
    </button>
  </div>

  <!-- ════════════════════════════════════════
       TAB 1: VIDEO SPACES (Instant Local MP4 DB)
       ════════════════════════════════════════ -->
  <div id="drawer-panel-spaces" class="drawer-panel flex flex-col flex-1 min-h-0">

    <!-- Search -->
    <div class="p-4 border-b border-hairline/60 shrink-0">
      <div class="relative">
        <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-ink-subtle">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </span>
        <input type="text" id="space-search" placeholder="Search video spaces…" autocomplete="off"
          class="w-full bg-surface-2/70 border border-hairline focus:border-primary-focus focus:outline-none rounded-md py-2 pl-9 pr-4 text-sm text-ink placeholder-ink-subtle transition font-sans"/>
      </div>
    </div>

    <!-- Category pills -->
    <div class="flex gap-1.5 px-3 py-2.5 overflow-x-auto border-b border-hairline/60 whitespace-nowrap shrink-0" style="scrollbar-width:none;">
      {spaceCategories.map((cat, idx) => (
        <button class={`category-tab space-cat px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition shrink-0 ${idx === 0 ? "bg-primary text-white" : "bg-surface-2 text-ink-subtle hover:text-ink"}`} data-category={cat}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Space cards -->
    <div id="spaces-list-container" class="flex-1 overflow-y-auto p-3 space-y-3">
      {spaces.map((space, idx) => (
        <div
          class={`space-card bg-surface-1/90 border hover:border-hairline-strong hover:bg-surface-2/90 transition duration-200 rounded-lg overflow-hidden flex flex-col relative group ${idx === 0 ? "border-primary/50" : "border-hairline"}`}
          data-id={space.id}
          data-content-url={space.contentUrl}
          data-content-type={space.contentType}
          data-title={space.title}
          data-presets={JSON.stringify(space.presetSounds || {})}
          data-category={space.category}
          data-trending={space.isTrending ? "true" : "false"}
          data-new={space.isNew ? "true" : "false"}
        >
          <button
            type="button"
            class="space-select-btn w-full text-left cursor-pointer focus:outline-none"
            aria-label={`Select space ${space.title}`}
          >
            <!-- Thumbnail -->
            <div class="relative h-[108px] w-full bg-canvas/80 overflow-hidden">
              <img src={space.thumbnailUrl} alt={space.title} referrerpolicy="no-referrer"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none" loading="lazy"/>
              <!-- Badges -->
              <div class="absolute top-2 left-2 flex gap-1">
                {space.isTrending && <span class="bg-primary/90 text-white text-[10px] font-semibold px-2 py-0.5 rounded-sm uppercase tracking-wider">Trending</span>}
                {space.isNew      && <span class="bg-semantic-success/90 text-white text-[10px] font-semibold px-2 py-0.5 rounded-sm uppercase tracking-wider">New</span>}
                <span class="bg-black/75 text-ink-muted text-[10px] font-mono px-2 py-0.5 rounded-sm">Instant</span>
              </div>
              <!-- Active users -->
              {space.activeUsers && (
                <div class="absolute bottom-2 right-2 bg-black/75 px-2 py-0.5 rounded-sm flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 bg-semantic-success rounded-full" aria-hidden="true"></span>
                  <span class="text-[10px] text-ink font-mono">{space.activeUsers} here</span>
                </div>
              )}
            </div>
            <!-- Info -->
            <div class="p-3">
              <span class="text-[11px] text-primary font-medium uppercase tracking-wider">{space.category}</span>
              <h3 class="font-sans font-semibold text-sm text-ink mt-0.5 group-hover:text-primary-hover transition-colors leading-snug">{space.title}</h3>
            </div>
          </button>
          <!-- Favorite star (sibling button, not nested) -->
          <button type="button" class="fav-btn absolute top-2 right-2 w-6 h-6 rounded-full bg-black/60 border border-white/10 flex items-center justify-center text-[11px] hover:bg-black/80 transition cursor-pointer z-10" data-id={space.id} aria-label={`Favorite ${space.title}`}>☆</button>
        </div>
      ))}
    </div>
  </div>

  <!-- ════════════════════════════════════════
       TAB 2: STATIC BACKGROUNDS
       ════════════════════════════════════════ -->
  <div id="drawer-panel-backgrounds" class="drawer-panel flex flex-col flex-1 min-h-0" style="display:none">

    <!-- Category pills -->
    <div class="flex gap-1.5 px-3 py-3 overflow-x-auto border-b border-hairline/60 whitespace-nowrap shrink-0" style="scrollbar-width:none;">
      {bgCategories.map((cat, idx) => (
        <button class={`bg-cat-tab px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition shrink-0 ${idx === 0 ? "bg-primary text-white" : "bg-surface-2 text-ink-subtle hover:text-ink"}`} data-category={cat}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Backgrounds grid -->
    <div id="bg-grid" class="flex-1 overflow-y-auto p-3 grid grid-cols-2 gap-2.5 content-start">
      {staticBgs.map(bg => (
        <button
          type="button"
          class="bg-library-card border border-hairline rounded-lg overflow-hidden cursor-pointer relative group text-left"
          data-bg-id={bg.id}
          data-bg-url={bg.contentUrl}
          data-bg-title={bg.title}
          data-bg-category={bg.category}
          data-bg-type="image"
          aria-label={`Apply background ${bg.title}`}
        >
          <div class="relative h-24 overflow-hidden">
            <img src={bg.thumbnailUrl} alt={bg.title} referrerpolicy="no-referrer"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none" loading="lazy"/>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 transition text-white text-xs font-semibold bg-black/60 px-2 py-1 rounded-md">Apply</span>
            </div>
          </div>
          <div class="px-2 py-1.5">
            <p class="text-[10px] font-semibold text-ink-subtle uppercase tracking-wide">{bg.category}</p>
            <p class="text-xs text-ink font-medium leading-tight">{bg.title}</p>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- ════════════════════════════════════════
       TAB 3: MY UPLOADS
       ════════════════════════════════════════ -->
  <div id="drawer-panel-uploads" class="drawer-panel flex flex-col flex-1 min-h-0" style="display:none">

    <!-- Upload area -->
    <div class="p-4 border-b border-hairline/60 shrink-0 space-y-3">
      <label for="bg-upload-input" class="flex flex-col items-center gap-3 p-5 border-2 border-dashed border-hairline hover:border-primary/50 rounded-xl cursor-pointer transition group bg-surface-2/20 hover:bg-primary/5">
        <div class="w-10 h-10 rounded-full bg-surface-2 group-hover:bg-primary/20 border border-hairline group-hover:border-primary/40 flex items-center justify-center transition">
          <svg class="w-5 h-5 text-ink-subtle group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-sm font-semibold text-ink group-hover:text-primary-hover transition">Upload Background</p>
          <p class="text-xs text-ink-subtle mt-0.5">Images (JPG, PNG, WebP) or Videos (MP4, WebM)</p>
        </div>
      </label>
      <input type="file" id="bg-upload-input" accept="image/*,video/mp4,video/webm" class="hidden" aria-label="Upload custom background"/>

      <!-- Save external MP4 or image URL directly to server DB -->
      <form id="custom-url-form" class="flex gap-1.5">
        <input
          type="url"
          id="custom-url-input"
          placeholder="Or paste MP4 / image URL to save…"
          class="flex-1 bg-surface-2/70 border border-hairline focus:border-primary-focus focus:outline-none rounded-md px-2.5 py-1.5 text-xs text-ink placeholder-ink-subtle font-sans"
        />
        <button type="submit" class="px-3 py-1.5 rounded-md bg-primary hover:bg-primary-hover text-white text-xs font-semibold transition cursor-pointer shrink-0">
          Save
        </button>
      </form>
    </div>

    <!-- Custom uploads list -->
    <div id="custom-uploads-list" class="flex-1 overflow-y-auto p-3 space-y-2">
      <p class="text-xs text-ink-subtle text-center py-6" id="no-uploads-msg">
        No custom uploads yet.<br/>Upload a file or paste a media URL above.
      </p>
    </div>
  </div>
</div>

<style>
  .drawer-tab { border-radius: 0; }
  #bg-grid { align-content: start; }
</style>

<script>
  import { recordVideoView, syncVideosFromServer } from '../utils/VideoDatabase';

  const drawer   = document.getElementById("spaces-drawer");
  const closeBtn = document.getElementById("close-drawer");
  closeBtn?.addEventListener("click", () => drawer?.classList.add("-translate-x-full"));

  // Sync database from server on load
  syncVideosFromServer().catch(() => {});

  // ── Main tab system ──────────────────────────────────────────────
  const mainTabs   = ["spaces", "backgrounds", "uploads"].map(id => document.getElementById(`drawer-tab-${id}`));
  const mainPanels = ["spaces", "backgrounds", "uploads"].map(id => document.getElementById(`drawer-panel-${id}`));

  mainTabs.forEach((tab, idx) => {
    tab?.addEventListener("click", () => {
      mainTabs.forEach((t, i) => {
        t?.classList.toggle("border-primary", i === idx);
        t?.classList.toggle("text-ink",       i === idx);
        t?.classList.toggle("border-transparent", i !== idx);
        t?.classList.toggle("text-ink-subtle", i !== idx);
        t?.setAttribute("aria-selected", (i === idx).toString());
      });
      mainPanels.forEach((p, i) => {
        if (!p) return;
        (p as HTMLElement).style.display = (i === idx) ? "flex" : "none";
      });
    });
  });

  // ── Space search & filter ────────────────────────────────────────
  const searchInput  = document.getElementById("space-search") as HTMLInputElement;
  const spaceCatTabs = document.querySelectorAll<HTMLButtonElement>(".space-cat");
  const spaceCards   = document.querySelectorAll<HTMLElement>(".space-card");

  let activeSpaceCat = "All Spaces";
  let searchQuery    = "";

  function filterSpaces() {
    spaceCards.forEach(card => {
      const title      = card.getAttribute("data-title")?.toLowerCase() || "";
      const category   = card.getAttribute("data-category") || "";
      const isTrending = card.getAttribute("data-trending") === "true";
      const isNew      = card.getAttribute("data-new")      === "true";
      const matchSearch = title.includes(searchQuery);
      const matchCat    = activeSpaceCat === "All Spaces" ? true
        : activeSpaceCat === "Trending"    ? isTrending
        : activeSpaceCat === "New Spaces"  ? isNew
        : category === activeSpaceCat;
      card.classList.toggle("hidden", !(matchSearch && matchCat));
    });
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    filterSpaces();
  });
  spaceCatTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      spaceCatTabs.forEach(t => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-surface-2", "text-ink-subtle");
      });
      tab.classList.add("bg-primary", "text-white");
      tab.classList.remove("bg-surface-2", "text-ink-subtle");
      activeSpaceCat = tab.getAttribute("data-category") || "All Spaces";
      filterSpaces();
    });
  });

  // ── Space card click — instant local MP4 switch ──────────────────
  spaceCards.forEach(card => {
    const selectBtn = card.querySelector<HTMLButtonElement>(".space-select-btn");
    selectBtn?.addEventListener("click", () => {
      const id          = card.getAttribute("data-id") || "";
      const contentUrl  = card.getAttribute("data-content-url") || "";
      const contentType = card.getAttribute("data-content-type") || "direct_video";
      const title       = card.getAttribute("data-title") || "";
      let presets: Record<string, number> = {};
      try { presets = JSON.parse(card.getAttribute("data-presets") || "{}"); } catch {}

      document.dispatchEvent(new CustomEvent("change-space", {
        detail: { id, contentUrl, contentType, title, presets }
      }));

      if (id) recordVideoView(id);
      drawer?.classList.add("-translate-x-full");

      spaceCards.forEach(c => {
        c.classList.remove("border-primary/50");
        c.classList.add("border-hairline");
      });
      card.classList.remove("border-hairline");
      card.classList.add("border-primary/50");
    });
  });

  // ── Favorites (spaces) ───────────────────────────────────────────
  function getFavs(): string[] {
    try { return JSON.parse(localStorage.getItem("sa_favorites_v1") || "[]").map((f: any) => f.itemId); }
    catch { return []; }
  }
  function toggleFav(id: string) {
    try {
      const favs: any[] = JSON.parse(localStorage.getItem("sa_favorites_v1") || "[]");
      const idx = favs.findIndex((f: any) => f.itemId === id);
      if (idx >= 0) favs.splice(idx, 1);
      else favs.push({ itemId: id, itemType: "space", addedAt: new Date().toISOString() });
      localStorage.setItem("sa_favorites_v1", JSON.stringify(favs));
    } catch {}
  }

  document.querySelectorAll<HTMLButtonElement>(".fav-btn").forEach(btn => {
    const id = btn.getAttribute("data-id") || "";
    const isFav = getFavs().includes(id);
    btn.textContent = isFav ? "⭐" : "☆";
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleFav(id);
      btn.textContent = getFavs().includes(id) ? "⭐" : "☆";
    });
  });

  // ── Static background category filter ───────────────────────────
  const bgCatTabs = document.querySelectorAll<HTMLButtonElement>(".bg-cat-tab");
  const bgCards   = document.querySelectorAll<HTMLElement>(".bg-library-card");

  bgCatTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      bgCatTabs.forEach(t => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-surface-2", "text-ink-subtle");
      });
      tab.classList.add("bg-primary", "text-white");
      tab.classList.remove("bg-surface-2", "text-ink-subtle");
      const cat = tab.getAttribute("data-category") || "All";
      bgCards.forEach(card => {
        const cardCat = card.getAttribute("data-bg-category") || "";
        card.classList.toggle("hidden", cat !== "All" && cardCat !== cat);
      });
    });
  });

  bgCards.forEach(card => {
    card.addEventListener("click", () => {
      const url   = card.getAttribute("data-bg-url") || "";
      const title = card.getAttribute("data-bg-title") || "";
      const id    = card.getAttribute("data-bg-id") || "";

      document.dispatchEvent(new CustomEvent("change-background", {
        detail: { type: "image", url, title, id }
      }));

      bgCards.forEach(c => c.classList.remove("is-active"));
      card.classList.add("is-active");
      drawer?.classList.add("-translate-x-full");
    });
  });

  // ── Custom Upload & Server DB Save handling ─────────────────────
  const uploadInput    = document.getElementById("bg-upload-input") as HTMLInputElement;
  const customUrlForm  = document.getElementById("custom-url-form") as HTMLFormElement;
  const customUrlInput = document.getElementById("custom-url-input") as HTMLInputElement;
  const uploadsList    = document.getElementById("custom-uploads-list");
  const noUploadsMsg   = document.getElementById("no-uploads-msg");

  function renderCustomUploads() {
    const customs: any[] = (() => {
      try { return JSON.parse(localStorage.getItem("sa_custom_backgrounds_v1") || "[]"); }
      catch { return []; }
    })();

    if (!uploadsList) return;
    uploadsList.querySelectorAll(".custom-upload-item").forEach(el => el.remove());

    if (customs.length === 0) {
      noUploadsMsg?.classList.remove("hidden");
      return;
    }
    noUploadsMsg?.classList.add("hidden");

    customs.forEach((item: any) => {
      const div = document.createElement("div");
      div.className = "custom-upload-item flex items-center gap-3 p-2.5 bg-surface-2/50 border border-hairline rounded-lg cursor-pointer hover:border-hairline-strong transition group";

      const preview = document.createElement("div");
      preview.className = "w-16 h-10 rounded overflow-hidden shrink-0 bg-surface-3";
      if (item.contentType === "image") {
        const img = document.createElement("img");
        img.src = item.contentUrl;
        img.referrerPolicy = "no-referrer";
        img.className = "w-full h-full object-cover";
        preview.appendChild(img);
      } else {
        preview.innerHTML = `<div class="w-full h-full flex items-center justify-center text-sm text-ink-subtle font-mono">MP4</div>`;
      }

      const info = document.createElement("div");
      info.className = "flex-1 min-w-0";
      const titleP = document.createElement("p");
      titleP.className = "text-xs font-semibold text-ink truncate";
      titleP.textContent = item.title;
      const typeP = document.createElement("p");
      typeP.className = "text-[10px] text-ink-subtle";
      typeP.textContent = item.contentType === "image" ? "Image" : "Video";
      info.appendChild(titleP);
      info.appendChild(typeP);

      const del = document.createElement("button");
      del.type = "button";
      del.className = "text-ink-subtle hover:text-red-400 p-1 rounded transition shrink-0 cursor-pointer";
      del.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`;
      del.setAttribute("aria-label", `Delete ${item.title}`);
      del.addEventListener("click", (e) => {
        e.stopPropagation();
        try {
          const list: any[] = JSON.parse(localStorage.getItem("sa_custom_backgrounds_v1") || "[]");
          localStorage.setItem("sa_custom_backgrounds_v1", JSON.stringify(list.filter((c: any) => c.id !== item.id)));
        } catch {}
        if (item.serverId) {
          fetch(`/api/videos?id=${encodeURIComponent(item.serverId)}`, { method: 'DELETE' }).catch(() => {});
        }
        renderCustomUploads();
      });

      div.appendChild(preview);
      div.appendChild(info);
      div.appendChild(del);

      div.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("button")) return;
        document.dispatchEvent(new CustomEvent("change-background", {
          detail: { type: item.contentType === "image" ? "image" : "video", url: item.contentUrl, title: item.title, id: item.id }
        }));
        drawer?.classList.add("-translate-x-full");
      });

      uploadsList.appendChild(div);
    });
  }

  uploadInput?.addEventListener("change", (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const isVideo = file.type.startsWith("video/");
    const isImage = file.type.startsWith("image/");
    if (!isVideo && !isImage) return;

    const type = isVideo ? "video" : "image";
    const title = file.name.replace(/\.[^.]+$/, "");

    const saveAndApply = (url: string) => {
      const newUpload = {
        id: `upload-${Date.now()}`,
        title,
        contentUrl: url,
        contentType: type,
        uploadDate: new Date().toISOString(),
      };

      try {
        const list: any[] = JSON.parse(localStorage.getItem("sa_custom_backgrounds_v1") || "[]");
        list.unshift(newUpload);
        localStorage.setItem("sa_custom_backgrounds_v1", JSON.stringify(list.slice(0, 50)));
      } catch {}

      renderCustomUploads();

      document.dispatchEvent(new CustomEvent("change-background", {
        detail: { type, url, title: newUpload.title, id: newUpload.id }
      }));

      uploadInput.value = "";
    };

    if (isImage && file.size <= 2 * 1024 * 1024) {
      const reader = new FileReader();
      reader.onload = () => saveAndApply(typeof reader.result === "string" ? reader.result : URL.createObjectURL(file));
      reader.readAsDataURL(file);
    } else {
      saveAndApply(URL.createObjectURL(file));
    }
  });

  customUrlForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const rawUrl = customUrlInput?.value.trim() || "";
    if (!rawUrl) return;
    const isImage = /\.(jpe?g|png|webp|gif|avif)(\?.*)?$/i.test(rawUrl);
    const contentType = isImage ? "image" : "direct_video";
    let title = "Custom Media";
    try {
      const u = new URL(rawUrl, window.location.origin);
      const base = u.pathname.split("/").pop() || "";
      if (base) title = base.replace(/\.[^.]+$/, "").slice(0, 40) || title;
    } catch {}

    let serverId: string | undefined;
    try {
      const res = await fetch("/api/videos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title, contentUrl: rawUrl, contentType }),
      });
      if (res.ok) {
        const data = await res.json();
        serverId = data?.video?.id;
      }
    } catch {}

    const newUpload = {
      id: serverId || `upload-${Date.now()}`,
      serverId,
      title,
      contentUrl: rawUrl,
      contentType: isImage ? "image" : "video",
      uploadDate: new Date().toISOString(),
    };
    try {
      const list: any[] = JSON.parse(localStorage.getItem("sa_custom_backgrounds_v1") || "[]");
      list.unshift(newUpload);
      localStorage.setItem("sa_custom_backgrounds_v1", JSON.stringify(list.slice(0, 50)));
    } catch {}

    renderCustomUploads();
    document.dispatchEvent(new CustomEvent("change-background", {
      detail: { type: isImage ? "image" : "video", url: rawUrl, title, id: newUpload.id }
    }));
    if (customUrlInput) customUrlInput.value = "";
    drawer?.classList.add("-translate-x-full");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !drawer?.classList.contains("-translate-x-full")) {
      drawer?.classList.add("-translate-x-full");
    }
  });

  renderCustomUploads();
</script>
