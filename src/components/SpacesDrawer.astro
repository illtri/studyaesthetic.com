---
// e:/ARUNAV WORKS/studyaesthetic.com/src/components/SpacesDrawer.astro
import { getVideoSpaces, getStaticBackgrounds } from '../utils/VideoDatabase';

// The catalogue lives in VideoDatabase so there is a single source of
// truth — this file used to keep a second, already-drifted copy.
const spaces = getVideoSpaces();
const staticBgs = getStaticBackgrounds();

const spaceCategories = ["All Spaces", "Trending", "New Spaces", "Cozy Rooms", "Cafes", "Nature & Rain", "City & Travel"];
const bgCategories    = ["All", "Minimal", "Nature", "Aesthetic", "Dark Mode", "Abstract"];
---

<!-- ═══════════════════════════════════════════════════════════
     SPACES & BACKGROUND LIBRARY DRAWER
     Three tabs: Video Spaces | Static Backgrounds | My Uploads
     ═══════════════════════════════════════════════════════════ -->
<div
  id="spaces-drawer"
  class="fixed top-0 left-0 h-full w-full sm:w-[400px] max-w-full z-50 glass -translate-x-full transition-transform duration-300 ease-out flex flex-col edge-highlight"
  role="dialog"
  aria-modal="true"
  aria-labelledby="spaces-drawer-title"
  aria-hidden="true"
>
  <!-- ── Header ─────────────────────────────────────── -->
  <div class="flex items-center justify-between p-5 border-b border-hairline shrink-0">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span id="spaces-drawer-title" class="font-sans font-semibold text-lg tracking-tight">Background Library</span>
    </div>
    <button id="close-drawer" type="button" class="text-ink-subtle hover:text-ink hover:bg-surface-2 p-1.5 rounded-md transition cursor-pointer" aria-label="Close background library">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- ── Main Tabs ───────────────────────────────────── -->
  <div class="flex gap-0 px-4 pt-3 border-b border-hairline shrink-0" role="tablist" aria-label="Background library sections">
    <button id="drawer-tab-spaces" type="button" role="tab" aria-selected="true" aria-controls="drawer-panel-spaces" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-primary text-ink cursor-pointer transition">
      🎬 Video Spaces
    </button>
    <button id="drawer-tab-backgrounds" type="button" role="tab" aria-selected="false" aria-controls="drawer-panel-backgrounds" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-transparent text-ink-subtle hover:text-ink cursor-pointer transition">
      🖼️ Static Backgrounds
    </button>
    <button id="drawer-tab-uploads" type="button" role="tab" aria-selected="false" aria-controls="drawer-panel-uploads" class="drawer-tab flex-1 pb-2.5 text-xs font-semibold border-b-2 border-transparent text-ink-subtle hover:text-ink cursor-pointer transition">
      ⬆️ My Uploads
    </button>
  </div>

  <!-- ════════════════════════════════════════
       TAB 1: VIDEO SPACES
       ════════════════════════════════════════ -->
  <div id="drawer-panel-spaces" class="drawer-panel flex flex-col flex-1 min-h-0" role="tabpanel" aria-labelledby="drawer-tab-spaces">

    <!-- Search -->
    <div class="p-4 border-b border-hairline/60 shrink-0">
      <div class="relative">
        <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-ink-subtle">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </span>
        <input type="text" id="space-search" placeholder="Search video spaces…" autocomplete="off" aria-label="Search video spaces"
          class="w-full bg-surface-2/70 border border-hairline focus:border-primary-focus focus:outline-none rounded-md py-2 pl-9 pr-4 text-sm text-ink placeholder-ink-subtle transition font-sans"/>
      </div>
    </div>

    <!-- Category pills -->
    <div class="flex gap-1.5 px-3 py-2.5 overflow-x-auto border-b border-hairline/60 whitespace-nowrap shrink-0" style="scrollbar-width:none;">
      {spaceCategories.map((cat, idx) => (
        <button type="button" class={`category-tab space-cat px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition shrink-0 ${idx === 0 ? "bg-primary text-white" : "bg-surface-2 text-ink-subtle hover:text-ink"}`} data-category={cat} aria-pressed={idx === 0 ? "true" : "false"}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Space cards -->
    <div id="spaces-list-container" class="flex-1 overflow-y-auto p-3 space-y-3">
      {spaces.map(space => (
        <div
          class="space-card bg-surface-1/90 border border-hairline hover:border-hairline-strong hover:bg-surface-2/90 transition duration-200 rounded-lg overflow-hidden cursor-pointer flex flex-col relative group"
          data-id={space.id}
          data-video-id={space.contentUrl}
          data-title={space.title}
          data-presets={JSON.stringify(space.presetSounds ?? {})}
          data-category={space.category}
          data-trending={space.isTrending ? "true" : "false"}
          data-new={space.isNew ? "true" : "false"}
          role="button"
          tabindex="0"
          aria-label={`Use space: ${space.title}`}
        >
          <!-- Thumbnail -->
          <div class="relative h-[108px] w-full bg-canvas/80 overflow-hidden">
            <img src={`https://img.youtube.com/vi/${space.contentUrl}/mqdefault.jpg`} alt={space.title}
              width="320" height="180"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none" loading="lazy"/>
            <!-- Badges -->
            <div class="absolute top-2 left-2 flex gap-1">
              {space.isTrending && <span class="bg-primary/90 text-white text-[10px] font-semibold px-2 py-0.5 rounded-sm uppercase tracking-wider">Trending</span>}
              {space.isNew      && <span class="bg-semantic-success/90 text-white text-[10px] font-semibold px-2 py-0.5 rounded-sm uppercase tracking-wider">New</span>}
            </div>
            <!-- Active users -->
            <div class="absolute bottom-2 right-2 bg-black/75 px-2 py-0.5 rounded-sm flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-semantic-success rounded-full animate-ping" aria-hidden="true"></span>
              <span class="text-[10px] text-ink font-mono">{space.activeUsers} here</span>
            </div>
            <!-- Favorite star -->
            <button type="button" class="fav-btn absolute top-2 right-2 w-6 h-6 rounded-full bg-black/60 border border-white/10 flex items-center justify-center text-[11px] hover:bg-black/80 transition cursor-pointer" data-id={space.id} aria-label={`Favorite ${space.title}`} aria-pressed="false">☆</button>
          </div>
          <!-- Info -->
          <div class="p-3">
            <span class="text-[11px] text-primary font-medium uppercase tracking-wider">{space.category}</span>
            <h3 class="font-sans font-semibold text-sm text-ink mt-0.5 group-hover:text-primary-hover transition-colors leading-snug">{space.title}</h3>
          </div>
        </div>
      ))}
      <!-- Empty state for search / filter combinations -->
      <p id="spaces-empty" class="hidden text-xs text-ink-subtle text-center py-8">
        No spaces match that search. Try another category or keyword.
      </p>
    </div>
  </div>

  <!-- ════════════════════════════════════════
       TAB 2: STATIC BACKGROUNDS
       ════════════════════════════════════════ -->
  <div id="drawer-panel-backgrounds" class="drawer-panel flex flex-col flex-1 min-h-0" style="display:none" role="tabpanel" aria-labelledby="drawer-tab-backgrounds">

    <!-- Category pills -->
    <div class="flex gap-1.5 px-3 py-3 overflow-x-auto border-b border-hairline/60 whitespace-nowrap shrink-0" style="scrollbar-width:none;">
      {bgCategories.map((cat, idx) => (
        <button type="button" class={`bg-cat-tab px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition shrink-0 ${idx === 0 ? "bg-primary text-white" : "bg-surface-2 text-ink-subtle hover:text-ink"}`} data-category={cat} aria-pressed={idx === 0 ? "true" : "false"}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Backgrounds grid -->
    <div id="bg-grid" class="flex-1 overflow-y-auto p-3 grid grid-cols-2 gap-2.5 content-start">
      {staticBgs.map(bg => (
        <div
          class="bg-library-card border border-hairline rounded-lg overflow-hidden cursor-pointer relative group"
          data-bg-id={bg.id}
          data-bg-url={bg.contentUrl}
          data-bg-title={bg.title}
          data-bg-category={bg.category}
          data-bg-type="image"
          role="button"
          tabindex="0"
          aria-label={`Use background: ${bg.title}`}
        >
          <div class="relative h-24 overflow-hidden">
            <img src={bg.thumbnailUrl} alt={bg.title}
              width="400" height="225"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none" loading="lazy"/>
            <!-- Overlay on hover -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 transition text-white text-xs font-semibold bg-black/60 px-2 py-1 rounded-md">Apply</span>
            </div>
          </div>
          <div class="px-2 py-1.5">
            <p class="text-[10px] font-semibold text-ink-subtle uppercase tracking-wide">{bg.category}</p>
            <p class="text-xs text-ink font-medium leading-tight">{bg.title}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ════════════════════════════════════════
       TAB 3: MY UPLOADS
       ════════════════════════════════════════ -->
  <div id="drawer-panel-uploads" class="drawer-panel flex flex-col flex-1 min-h-0" style="display:none" role="tabpanel" aria-labelledby="drawer-tab-uploads">

    <!-- Upload area -->
    <div class="p-4 border-b border-hairline/60 shrink-0">
      <label for="bg-upload-input" class="flex flex-col items-center gap-3 p-6 border-2 border-dashed border-hairline hover:border-primary/50 rounded-xl cursor-pointer transition group bg-surface-2/20 hover:bg-primary/5">
        <div class="w-10 h-10 rounded-full bg-surface-2 group-hover:bg-primary/20 border border-hairline group-hover:border-primary/40 flex items-center justify-center transition">
          <svg class="w-5 h-5 text-ink-subtle group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-sm font-semibold text-ink group-hover:text-primary-hover transition">Upload Background</p>
          <p class="text-xs text-ink-subtle mt-0.5">Images (JPG, PNG, WebP) or Videos (MP4, WebM)</p>
          <p class="text-[10px] text-ink-subtle/60 mt-1">Images up to 3 MB · Videos up to 50 MB (session only)</p>
        </div>
      </label>
      <input type="file" id="bg-upload-input" accept="image/*,video/mp4,video/webm" class="hidden" aria-label="Upload custom background"/>
    </div>

    <!-- Custom uploads list -->
    <div id="custom-uploads-list" class="flex-1 overflow-y-auto p-3 space-y-2">
      <p class="text-xs text-ink-subtle text-center py-6" id="no-uploads-msg">
        No custom uploads yet.<br/>Upload an image or video above!
      </p>
    </div>
  </div>
</div>

<style>
  .drawer-tab { border-radius: 0; }
  #bg-grid { align-content: start; }
</style>

<script>
  import { getCustomUploads, addCustomUpload, removeCustomUpload, resolveContentUrl, MAX_IMAGE_UPLOAD_BYTES, MAX_VIDEO_UPLOAD_BYTES } from '../utils/VideoDatabase';
  import { toggleFavorite, isFavorite } from '../utils/UserStore';
  import { showToast } from '../utils/toast';

  // ── Drawer open/close ────────────────────────────────────────────
  const drawer    = document.getElementById("spaces-drawer");
  const closeBtn  = document.getElementById("close-drawer");

  function requestClose() {
    document.dispatchEvent(new CustomEvent("close-drawer"));
  }
  closeBtn?.addEventListener("click", requestClose);

  // Keep the keyboard focus inside the drawer while it is open
  const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  document.addEventListener("drawer-state", (e: any) => {
    if (!e.detail?.open) return;
    // Move focus into the drawer
    const first = drawer?.querySelector<HTMLElement>(FOCUSABLE);
    first?.focus();
  });

  drawer?.addEventListener("keydown", (e) => {
    if (e.key !== "Tab") return;
    const items = Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE))
      .filter(el => el.offsetParent !== null);
    if (items.length === 0) return;
    const first = items[0];
    const last  = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // ── Main tab system ──────────────────────────────────────────────
  const mainTabs   = ["spaces", "backgrounds", "uploads"].map(id => document.getElementById(`drawer-tab-${id}`));
  const mainPanels = ["spaces", "backgrounds", "uploads"].map(id => document.getElementById(`drawer-panel-${id}`));

  function activateMainTab(idx: number) {
    mainTabs.forEach((t, i) => {
      const isActive = i === idx;
      t?.classList.toggle("border-primary", isActive);
      t?.classList.toggle("text-ink", isActive);
      t?.classList.toggle("border-transparent", !isActive);
      t?.classList.toggle("text-ink-subtle", !isActive);
      t?.setAttribute("aria-selected", isActive ? "true" : "false");
    });
    mainPanels.forEach((p, i) => {
      if (!p) return;
      (p as HTMLElement).style.display = (i === idx) ? "flex" : "none";
    });
  }

  mainTabs.forEach((tab, idx) => {
    tab?.addEventListener("click", () => activateMainTab(idx));
    tab?.addEventListener("keydown", (e) => {
      const i = mainTabs.indexOf(tab as HTMLElement);
      let next = -1;
      if (e.key === "ArrowRight") next = (i + 1) % mainTabs.length;
      if (e.key === "ArrowLeft")  next = (i - 1 + mainTabs.length) % mainTabs.length;
      if (next >= 0) {
        e.preventDefault();
        (mainTabs[next] as HTMLElement).focus();
        activateMainTab(next);
      }
    });
  });

  // ── Space search & filter ────────────────────────────────────────
  const searchInput  = document.getElementById("space-search") as HTMLInputElement;
  const spaceCatTabs = document.querySelectorAll<HTMLButtonElement>(".space-cat");
  const spaceCards   = document.querySelectorAll<HTMLElement>(".space-card");
  const spacesEmpty  = document.getElementById("spaces-empty");

  let activeSpaceCat = "All Spaces";
  let searchQuery    = "";

  function filterSpaces() {
    let visible = 0;
    spaceCards.forEach(card => {
      const title      = card.getAttribute("data-title")?.toLowerCase() || "";
      const category   = card.getAttribute("data-category") || "";
      const isTrending = card.getAttribute("data-trending") === "true";
      const isNew      = card.getAttribute("data-new")      === "true";
      const matchSearch = title.includes(searchQuery);
      const matchCat    = activeSpaceCat === "All Spaces" ? true
        : activeSpaceCat === "Trending"    ? isTrending
        : activeSpaceCat === "New Spaces"  ? isNew
        : category === activeSpaceCat;
      const visibleCard = matchSearch && matchCat;
      card.classList.toggle("hidden", !visibleCard);
      if (visibleCard) visible++;
    });
    spacesEmpty?.classList.toggle("hidden", visible > 0);
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    filterSpaces();
  });
  spaceCatTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      spaceCatTabs.forEach(t => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-surface-2", "text-ink-subtle");
        t.setAttribute("aria-pressed", "false");
      });
      tab.classList.add("bg-primary", "text-white");
      tab.classList.remove("bg-surface-2", "text-ink-subtle");
      tab.setAttribute("aria-pressed", "true");
      activeSpaceCat = tab.getAttribute("data-category") || "All Spaces";
      filterSpaces();
    });
  });

  // ── Space card activation (click + keyboard) ─────────────────────
  function activateSpace(card: HTMLElement) {
    const videoId = card.getAttribute("data-video-id");
    const title   = card.getAttribute("data-title");
    let presets: Record<string, number> = {};
    try {
      presets = JSON.parse(card.getAttribute("data-presets") || "{}");
    } catch {
      presets = {};
    }
    document.dispatchEvent(new CustomEvent("change-space", {
      detail: { id: card.getAttribute("data-id"), videoId, title, presets }
    }));
    requestClose();

    // Mark active — a dedicated class, because two Tailwind border
    // colour utilities on one element resolve by stylesheet order.
    spaceCards.forEach(c => c.classList.remove("is-active"));
    card.classList.add("is-active");
  }

  spaceCards.forEach(card => {
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest(".fav-btn")) return;
      activateSpace(card);
    });
    card.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      if ((e.target as HTMLElement).closest(".fav-btn")) return;
      e.preventDefault();
      activateSpace(card);
    });
  });

  // ── Favorites (spaces) ───────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".fav-btn").forEach(btn => {
    const id = btn.getAttribute("data-id") || "";
    const syncFavState = () => {
      const isFav = isFavorite(id);
      btn.textContent = isFav ? "⭐" : "☆";
      btn.setAttribute("aria-pressed", isFav ? "true" : "false");
    };
    syncFavState();
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleFavorite(id, "space");
      syncFavState();
    });
  });

  // ── Static background category filter ───────────────────────────
  const bgCatTabs  = document.querySelectorAll<HTMLButtonElement>(".bg-cat-tab");
  const bgCards    = document.querySelectorAll<HTMLElement>(".bg-library-card");

  bgCatTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      bgCatTabs.forEach(t => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-surface-2", "text-ink-subtle");
        t.setAttribute("aria-pressed", "false");
      });
      tab.classList.add("bg-primary", "text-white");
      tab.classList.remove("bg-surface-2", "text-ink-subtle");
      tab.setAttribute("aria-pressed", "true");
      const cat = tab.getAttribute("data-category") || "All";
      bgCards.forEach(card => {
        const cardCat = card.getAttribute("data-bg-category") || "";
        card.classList.toggle("hidden", cat !== "All" && cardCat !== cat);
      });
    });
  });

  // ── Static background card activation ───────────────────────────
  function activateBackground(card: HTMLElement) {
    const url   = card.getAttribute("data-bg-url")   || "";
    const title = card.getAttribute("data-bg-title")  || "";
    const id    = card.getAttribute("data-bg-id")     || "";

    document.dispatchEvent(new CustomEvent("change-background", {
      detail: { type: "image", url, title, id }
    }));

    // Visual active state
    bgCards.forEach(c => c.classList.remove("is-active"));
    card.classList.add("is-active");

    requestClose();
  }

  bgCards.forEach(card => {
    card.addEventListener("click", () => activateBackground(card));
    card.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      activateBackground(card);
    });
  });

  // ── Custom Upload handling ───────────────────────────────────────
  const uploadInput    = document.getElementById("bg-upload-input") as HTMLInputElement;
  const uploadsList    = document.getElementById("custom-uploads-list");
  const noUploadsMsg   = document.getElementById("no-uploads-msg");

  function renderCustomUploads() {
    const customs = getCustomUploads();

    if (!uploadsList) return;
    uploadsList.querySelectorAll(".custom-upload-item").forEach(el => el.remove());

    if (customs.length === 0) {
      noUploadsMsg?.classList.remove("hidden");
      return;
    }
    noUploadsMsg?.classList.add("hidden");

    customs.forEach((item: any) => {
      const liveUrl = resolveContentUrl(item);

      const div = document.createElement("div");
      div.className = "custom-upload-item flex items-center gap-3 p-2.5 bg-surface-2/50 border border-hairline rounded-lg hover:border-hairline-strong transition group";
      div.tabIndex = 0;
      div.setAttribute("role", "button");
      div.setAttribute("aria-label", `Use background: ${item.title}`);

      const preview = document.createElement("div");
      preview.className = "w-16 h-10 rounded overflow-hidden shrink-0 bg-surface-3";
      if (item.contentType === "image" && liveUrl) {
        const img = document.createElement("img");
        img.src = liveUrl;
        img.alt = "";
        img.className = "w-full h-full object-cover";
        preview.appendChild(img);
      } else {
        const icon = document.createElement("div");
        icon.className = "w-full h-full flex items-center justify-center text-lg";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = "🎬";
        preview.appendChild(icon);
      }

      const info = document.createElement("div");
      info.className = "flex-1 min-w-0";

      // Use textContent — the file name is user supplied and was
      // previously injected as HTML.
      const title = document.createElement("p");
      title.className = "text-xs font-semibold text-ink truncate";
      title.textContent = item.title;

      const meta = document.createElement("p");
      meta.className = "text-[10px] text-ink-subtle";
      meta.textContent = item.contentType === "image"
        ? "Image"
        : (liveUrl ? "Video (this session)" : "Video — re-upload to use again");

      info.appendChild(title);
      info.appendChild(meta);

      const del = document.createElement("button");
      del.type = "button";
      del.className = "text-ink-subtle hover:text-red-400 p-1 rounded transition shrink-0 cursor-pointer";
      del.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`;
      del.setAttribute("aria-label", `Delete upload: ${item.title}`);
      del.addEventListener("click", (e) => {
        e.stopPropagation();
        removeCustomUpload(item.id);
        renderCustomUploads();
        showToast("Upload deleted");
      });

      div.appendChild(preview);
      div.appendChild(info);
      div.appendChild(del);

      const apply = () => {
        if (!liveUrl) {
          showToast("This video is no longer available. Please upload it again.");
          return;
        }
        document.dispatchEvent(new CustomEvent("change-background", {
          detail: { type: item.contentType === "image" ? "image" : "direct_video", url: liveUrl, title: item.title, id: item.id }
        }));
        requestClose();
      };

      div.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("button")) return;
        apply();
      });
      div.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        e.preventDefault();
        apply();
      });

      uploadsList.appendChild(div);
    });
  }

  function readFileAsDataUrl(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error("Could not read the file."));
      reader.readAsDataURL(file);
    });
  }

  uploadInput?.addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;

    const isVideo = file.type.startsWith("video/");
    const isImage = file.type.startsWith("image/");
    if (!isVideo && !isImage) {
      showToast("Unsupported file type. Choose an image or a video.");
      input.value = "";
      return;
    }

    const title = file.name.replace(/\.[^.]+$/, "") || "Custom background";

    try {
      if (isImage) {
        if (file.size > MAX_IMAGE_UPLOAD_BYTES) {
          showToast("Image is too large. The maximum is 3 MB.");
          input.value = "";
          return;
        }
        // Images are stored as data URLs so they survive a reload.
        const dataUrl = await readFileAsDataUrl(file);
        addCustomUpload(title, dataUrl, "image");
      } else {
        if (file.size > MAX_VIDEO_UPLOAD_BYTES) {
          showToast("Video is too large. The maximum is 50 MB.");
          input.value = "";
          return;
        }
        // Videos use an object URL, which only lives for this session.
        const blobUrl = URL.createObjectURL(file);
        addCustomUpload(title, blobUrl, "direct_video");
      }
    } catch (err) {
      showToast("Could not save that upload. It may be too large for browser storage.");
      input.value = "";
      return;
    }

    renderCustomUploads();

    // Auto-apply the uploaded background
    const latest = getCustomUploads()[0];
    if (latest) {
      const liveUrl = resolveContentUrl(latest);
      if (liveUrl) {
        document.dispatchEvent(new CustomEvent("change-background", {
          detail: {
            type: latest.contentType === "image" ? "image" : "direct_video",
            url: liveUrl,
            title: latest.title,
            id: latest.id,
          }
        }));
        requestClose();
      }
    }

    input.value = "";
  });

  // ── Keyboard: Escape closes drawer ─────────────────────────────
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.classList.contains("-translate-x-full")) {
      requestClose();
    }
  });

  renderCustomUploads();
  filterSpaces();
</script>
