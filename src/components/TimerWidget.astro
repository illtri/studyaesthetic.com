---
// e:/ARUNAV WORKS/studyaesthetic.com/src/components/TimerWidget.astro
---

<div
  id="timer-widget"
  class="widget-island glass rounded-xl z-40 edge-highlight"
  data-widget-key="timer"
  data-default-x="80"
  data-default-y="80"
  style="width: 320px;"
>
  <!-- Widget Handle -->
  <div class="widget-handle flex items-center justify-between px-4 pt-4 pb-3 border-b border-hairline cursor-grab select-none">
    <div class="flex items-center gap-2 text-ink-subtle">
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-xs font-semibold uppercase tracking-wider font-sans">Pomodoro Timer</span>
    </div>
    <button
      class="minimize-btn text-ink-subtle hover:text-ink hover:bg-surface-2 p-1 rounded transition cursor-pointer"
      aria-label="Minimize timer widget"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>
      </svg>
    </button>
  </div>

  <!-- Widget Body -->
  <div class="widget-body px-4 pb-4 pt-4 flex flex-col items-center">
    <!-- Mode Selectors -->
    <div class="flex gap-1 p-1 bg-surface-2/60 border border-hairline rounded-lg w-full mb-5">
      <button id="mode-pomodoro" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium bg-primary text-white cursor-pointer transition" data-time="1500" aria-pressed="true">
        Pomodoro
      </button>
      <button id="mode-short" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition" data-time="300" aria-pressed="false">
        Short Break
      </button>
      <button id="mode-long" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition" data-time="900" aria-pressed="false">
        Long Break
      </button>
    </div>

    <!-- Countdown with SVG Ring -->
    <div class="relative w-44 h-44 flex items-center justify-center mb-5">
      <svg class="w-full h-full -rotate-90" aria-hidden="true">
        <circle cx="88" cy="88" r="80" stroke="var(--color-hairline)" stroke-width="4" fill="transparent"/>
        <circle
          id="timer-ring"
          cx="88" cy="88" r="80"
          stroke="var(--color-primary)"
          stroke-width="5"
          fill="transparent"
          stroke-dasharray="502.6"
          stroke-dashoffset="0"
          stroke-linecap="round"
          style="transition: stroke-dashoffset 0.9s linear;"
        />
      </svg>
      <div class="absolute flex flex-col items-center justify-center">
        <span id="timer-display" class="font-mono text-3xl font-bold tracking-tight text-ink" role="timer">25:00</span>
        <span id="timer-status" class="text-[10px] text-ink-subtle font-sans tracking-wide uppercase mt-1">Focusing</span>
      </div>
    </div>

    <!-- Screen-reader announcements for phase changes -->
    <p id="timer-announcer" class="sr-only" role="status" aria-live="polite"></p>

    <!-- Controls -->
    <div class="flex items-center gap-3 w-full">
      <button id="timer-start" class="flex-1 bg-primary hover:bg-primary-hover active:bg-primary-focus text-white font-medium text-sm py-2 rounded-md transition cursor-pointer flex items-center justify-center gap-1.5">
        <svg id="start-icon" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span id="start-text">Start</span>
      </button>
      <button id="timer-reset" class="bg-surface-2 hover:bg-surface-3 border border-hairline text-ink font-medium text-sm px-4 py-2 rounded-md transition cursor-pointer">
        Reset
      </button>
    </div>
  </div>
</div>

<script>
  import { recordSession } from '../utils/UserStore';
  import { showToast } from '../utils/toast';

  // ── Timer state ─────────────────────────────────────────────────
  type TimerMode = "pomodoro" | "short" | "long";

  let timeLeft      = 1500;
  let totalTime     = 1500;
  let currentMode: TimerMode = "pomodoro";
  let timerId: ReturnType<typeof setInterval> | null = null;
  let isRunning     = false;

  // Wall-clock bookkeeping. The countdown is derived from a target
  // timestamp instead of counting ticks, so the timer stays accurate
  // even when the browser throttles timers in a background tab.
  let endAt         = 0;        // ms timestamp when the countdown hits 0
  let sessionStart  = 0;        // ms timestamp of the current running segment
  let accumulated   = 0;        // seconds focused in previous segments

  const display       = document.getElementById("timer-display");
  const statusDisplay = document.getElementById("timer-status");
  const announcer     = document.getElementById("timer-announcer");
  const startBtn      = document.getElementById("timer-start");
  const resetBtn      = document.getElementById("timer-reset");
  const startText     = document.getElementById("start-text");
  const startIcon     = document.getElementById("start-icon");
  const ring          = document.getElementById("timer-ring") as unknown as SVGCircleElement;
  const modeButtons   = document.querySelectorAll(".timer-mode-btn");
  const ringCircumference = 502.65;

  const MODE_LABELS: Record<TimerMode, { status: string; done: string; doneBreak: string }> = {
    pomodoro: { status: "Focusing", done: "Focus session complete!", doneBreak: "Break finished!" },
    short:    { status: "Short break", done: "Short break finished!", doneBreak: "Short break finished!" },
    long:     { status: "Long break", done: "Long break finished!", doneBreak: "Long break finished!" },
  };

  // ── Audio ───────────────────────────────────────────────────────
  // One AudioContext for the whole page: browsers cap the number of
  // contexts and creating one per alert starts failing silently.
  let audioCtx: AudioContext | null = null;
  function getAudioCtx(): AudioContext | null {
    try {
      if (!audioCtx) {
        const Ctor = window.AudioContext || (window as any).webkitAudioContext;
        if (!Ctor) return null;
        audioCtx = new Ctor();
      }
      if (audioCtx.state === "suspended") audioCtx.resume().catch(() => {});
      return audioCtx;
    } catch {
      return null;
    }
  }

  function playAlertSound() {
    try {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc1 = ctx.createOscillator();
      const osc2 = ctx.createOscillator();
      const gain = ctx.createGain();
      osc1.type = "sine";
      osc1.frequency.setValueAtTime(523.25, ctx.currentTime);
      osc2.type = "sine";
      osc2.frequency.setValueAtTime(659.25, ctx.currentTime + 0.15);
      gain.gain.setValueAtTime(0, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.3, ctx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);
      osc1.connect(gain); osc2.connect(gain); gain.connect(ctx.destination);
      osc1.start(); osc2.start(ctx.currentTime + 0.15);
      osc1.stop(ctx.currentTime + 1.2); osc2.stop(ctx.currentTime + 1.2);
    } catch (e) { console.warn("AudioContext chime failed:", e); }
  }

  // ── Session recording ───────────────────────────────────────────
  function elapsedSeconds(): number {
    const segment = sessionStart ? (Date.now() - sessionStart) / 1000 : 0;
    return Math.max(0, Math.round(accumulated + segment));
  }

  function recordCompletedSession(duration: number) {
    const endTime = new Date().toISOString();
    const startedAt = new Date(Date.now() - duration * 1000).toISOString();

    try {
      recordSession({
        startTime: startedAt,
        endTime,
        duration,
        mode: currentMode,
        completed: true,
      });
    } catch (e) {
      console.warn("Could not record session:", e);
    }

    // Dispatch event for StatsWidget to refresh
    document.dispatchEvent(new CustomEvent("study-session-complete", {
      detail: { duration, mode: currentMode, endTime }
    }));
  }

  function updateDisplay() {
    const m = Math.floor(timeLeft / 60);
    const s = timeLeft % 60;
    if (display) display.textContent = `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    if (ring) {
      const offset = ringCircumference - (totalTime > 0 ? (timeLeft / totalTime) * ringCircumference : 0);
      ring.style.strokeDashoffset = offset.toString();
    }
  }

  function announcePhase(message: string) {
    if (announcer) announcer.textContent = message;
  }

  function startTimer() {
    if (isRunning) return;
    isRunning   = true;
    sessionStart = Date.now();
    endAt       = Date.now() + timeLeft * 1000;

    if (startText) startText.textContent = "Pause";
    if (startIcon) startIcon.innerHTML   = `<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>`;
    startBtn?.setAttribute("aria-label", "Pause timer");

    if (timerId) clearInterval(timerId);
    timerId = setInterval(tick, 250);
    tick();
  }

  function tick() {
    if (!isRunning) return;
    const remaining = Math.max(0, Math.round((endAt - Date.now()) / 1000));
    timeLeft = remaining;
    updateDisplay();
    if (remaining <= 0) completeTimer();
  }

  function completeTimer() {
    const duration = elapsedSeconds();
    const wasFocus = currentMode === "pomodoro";

    pauseTimer();
    timeLeft = totalTime;
    accumulated = 0;
    updateDisplay();

    playAlertSound();

    if (wasFocus && duration > 0) {
      recordCompletedSession(duration);
    }

    const label = wasFocus
      ? MODE_LABELS[currentMode].done
      : MODE_LABELS[currentMode].doneBreak;

    showToast(label, { duration: 6000 });
    announcePhase(label);
  }

  function pauseTimer() {
    if (!isRunning) return;
    isRunning = false;
    if (sessionStart) {
      accumulated += (Date.now() - sessionStart) / 1000;
      sessionStart = 0;
    }
    if (startText) startText.textContent = "Start";
    if (startIcon) startIcon.innerHTML   = `<path d="M8 5v14l11-7z"/>`;
    startBtn?.setAttribute("aria-label", "Start timer");
    if (timerId)   { clearInterval(timerId); timerId = null; }
  }

  function resetTimer() {
    pauseTimer();
    timeLeft     = totalTime;
    accumulated  = 0;
    sessionStart = 0;
    updateDisplay();
  }

  startBtn?.addEventListener("click", () => isRunning ? pauseTimer() : startTimer());
  resetBtn?.addEventListener("click", resetTimer);

  modeButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      modeButtons.forEach(b => {
        b.classList.remove("bg-primary", "text-white");
        b.classList.add("text-ink-subtle");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("bg-primary", "text-white");
      btn.classList.remove("text-ink-subtle");
      btn.setAttribute("aria-pressed", "true");

      const timeValue = parseInt(btn.getAttribute("data-time") || "1500");
      totalTime    = timeValue;
      currentMode  = (btn.id === "mode-pomodoro" ? "pomodoro" : btn.id === "mode-short" ? "short" : "long") as TimerMode;
      if (statusDisplay) statusDisplay.textContent = MODE_LABELS[currentMode].status;
      resetTimer();
    });
  });

  // ── Minimize toggle ─────────────────────────────────────────────
  const widget      = document.getElementById("timer-widget");
  const minimizeBtn = widget?.querySelector(".minimize-btn");
  minimizeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const minimized = widget?.classList.toggle("is-minimized");
    minimizeBtn.setAttribute("aria-expanded", minimized ? "false" : "true");
    minimizeBtn.setAttribute("aria-label", minimized ? "Expand timer widget" : "Minimize timer widget");
  });

  updateDisplay();
</script>
