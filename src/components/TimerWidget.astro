---
// e:/ARUNAV WORKS/studyaesthetic.com/src/components/TimerWidget.astro
---

<div
  id="timer-widget"
  class="widget-island glass rounded-xl z-40 edge-highlight"
  data-widget-key="timer"
  data-default-x="80"
  data-default-y="80"
  style="width: 320px;"
>
  <!-- Widget Handle -->
  <div class="widget-handle flex items-center justify-between px-4 pt-4 pb-3 border-b border-hairline cursor-grab select-none">
    <div class="flex items-center gap-2 text-ink-subtle">
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-xs font-semibold uppercase tracking-wider font-sans">Pomodoro Timer</span>
    </div>
    <button
      class="minimize-btn text-ink-subtle hover:text-ink hover:bg-surface-2 p-1 rounded transition cursor-pointer"
      aria-label="Minimize timer widget"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>
      </svg>
    </button>
  </div>

  <!-- Widget Body -->
  <div class="widget-body px-4 pb-4 pt-4 flex flex-col items-center">
    <!-- Mode Selectors -->
    <div class="flex gap-1 p-1 bg-surface-2/60 border border-hairline rounded-lg w-full mb-5">
      <button id="mode-pomodoro" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium bg-primary text-white cursor-pointer transition" data-time="1500">
        Pomodoro
      </button>
      <button id="mode-short" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition" data-time="300">
        Short Break
      </button>
      <button id="mode-long" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition" data-time="900">
        Long Break
      </button>
    </div>

    <!-- Countdown with SVG Ring -->
    <div class="relative w-44 h-44 flex items-center justify-center mb-5">
      <svg class="w-full h-full -rotate-90" aria-hidden="true">
        <circle cx="88" cy="88" r="80" stroke="var(--color-hairline)" stroke-width="4" fill="transparent"/>
        <circle
          id="timer-ring"
          cx="88" cy="88" r="80"
          stroke="var(--color-primary)"
          stroke-width="5"
          fill="transparent"
          stroke-dasharray="502.6"
          stroke-dashoffset="0"
          stroke-linecap="round"
          style="transition: stroke-dashoffset 0.9s linear;"
        />
      </svg>
      <div class="absolute flex flex-col items-center justify-center">
        <span id="timer-display" class="font-mono text-3xl font-bold tracking-tight text-ink" aria-live="polite" aria-atomic="true">25:00</span>
        <span id="timer-status" class="text-[10px] text-ink-subtle font-sans tracking-wide uppercase mt-1">Focusing</span>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-3 w-full">
      <button id="timer-start" class="flex-1 bg-primary hover:bg-primary-hover active:bg-primary-focus text-white font-medium text-sm py-2 rounded-md transition cursor-pointer flex items-center justify-center gap-1.5">
        <svg id="start-icon" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span id="start-text">Start</span>
      </button>
      <button id="timer-reset" class="bg-surface-2 hover:bg-surface-3 border border-hairline text-ink font-medium text-sm px-4 py-2 rounded-md transition cursor-pointer">
        Reset
      </button>
    </div>
  </div>
</div>

<script>
  // ── Timer state ─────────────────────────────────────────────────
  type TimerMode = "pomodoro" | "short" | "long";
  let timeLeft    = 1500;
  let totalTime   = 1500;
  let currentMode: TimerMode = "pomodoro";
  let sessionStartTime: number | null = null;
  let timerId: ReturnType<typeof setInterval> | null = null;
  let isRunning = false;

  const display       = document.getElementById("timer-display");
  const statusDisplay = document.getElementById("timer-status");
  const startBtn      = document.getElementById("timer-start");
  const resetBtn      = document.getElementById("timer-reset");
  const startText     = document.getElementById("start-text");
  const startIcon     = document.getElementById("start-icon");
  const ring          = document.getElementById("timer-ring") as unknown as SVGCircleElement;
  const modeButtons   = document.querySelectorAll(".timer-mode-btn");
  const ringCircumference = 502.65;

  function playAlertSound() {
    try {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc1 = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc1.type = "sine";
      osc1.frequency.setValueAtTime(523.25, audioCtx.currentTime);
      osc2.type = "sine";
      osc2.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.15);
      gain.gain.setValueAtTime(0, audioCtx.currentTime);
      gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.2);
      osc1.connect(gain); osc2.connect(gain); gain.connect(audioCtx.destination);
      osc1.start(); osc2.start(audioCtx.currentTime + 0.15);
      osc1.stop(audioCtx.currentTime + 1.2); osc2.stop(audioCtx.currentTime + 1.2);
    } catch (e) { console.warn("AudioContext chime failed:", e); }
  }

  // ── Record session in UserStore & dispatch event ─────────────────
  function recordCompletedSession() {
    if (!sessionStartTime) return;
    const endTime  = new Date().toISOString();
    const duration = totalTime;

    try {
      // UserStore session record
      const sessions: any[] = JSON.parse(localStorage.getItem("sa_sessions_v1") || "[]");
      sessions.push({
        id:        `${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
        userId:    JSON.parse(localStorage.getItem("sa_user_profile_v1") || "{}").id || "anon",
        startTime: new Date(sessionStartTime).toISOString(),
        endTime,
        duration,
        mode:      currentMode,
        completed: true,
      });
      localStorage.setItem("sa_sessions_v1", JSON.stringify(sessions.slice(-500)));

      // Update activity
      const today   = new Date().toISOString().split("T")[0];
      const activity = JSON.parse(localStorage.getItem("sa_activity_v1") || "{}");
      if (!activity[today]) {
        activity[today] = { date: today, focusMinutes: 0, sessionsCompleted: 0, tasksCompleted: 0, backgroundsUsed: [], widgetsUsed: [] };
      }
      if (currentMode === "pomodoro") {
        activity[today].focusMinutes     += Math.round(duration / 60);
        activity[today].sessionsCompleted++;
      }
      localStorage.setItem("sa_activity_v1", JSON.stringify(activity));

      // Recalculate stats (lightweight inline)
      recalcStats(sessions, activity);
    } catch {}

    // Dispatch event for StatsWidget to refresh
    document.dispatchEvent(new CustomEvent("study-session-complete", {
      detail: { duration, mode: currentMode, endTime }
    }));

    sessionStartTime = null;
  }

  function recalcStats(sessions: any[], activity: Record<string, any>) {
    const completed = sessions.filter(s => s.completed && s.mode === "pomodoro");
    const total     = completed.reduce((acc: number, s: any) => acc + s.duration, 0);

    const todayKey  = new Date().toISOString().split("T")[0];
    const weekAgo   = Date.now() - 6 * 86400000;

    const todaySecs = completed
      .filter((s: any) => new Date(s.startTime).getTime() >= new Date(todayKey + "T00:00:00").getTime())
      .reduce((a: number, s: any) => a + s.duration, 0);

    const weekSecs  = completed
      .filter((s: any) => new Date(s.startTime).getTime() >= weekAgo)
      .reduce((a: number, s: any) => a + s.duration, 0);

    const longest = completed.length ? Math.max(...completed.map((s: any) => s.duration)) : 0;
    const avg     = completed.length ? Math.round(total / completed.length) : 0;

    // Streak
    const days      = Object.keys(activity).sort().reverse();
    let streak      = 0;
    const todayHas  = (activity[todayKey]?.sessionsCompleted ?? 0) > 0;
    if (todayHas) {
      streak = 1;
      for (let i = 1; i < days.length; i++) {
        const prev = new Date(days[i - 1]);
        const curr = new Date(days[i]);
        const diff = (prev.getTime() - curr.getTime()) / 86400000;
        if (Math.abs(diff - 1) < 0.01 && activity[days[i]].sessionsCompleted > 0) streak++;
        else break;
      }
    }

    // Achievements
    const ALL_ACH = [
      { id: "first_session",  condition: () => completed.length >= 1    },
      { id: "ten_sessions",   condition: () => completed.length >= 10   },
      { id: "fifty_sessions", condition: () => completed.length >= 50   },
      { id: "one_hour",       condition: () => total >= 3600             },
      { id: "ten_hours",      condition: () => total >= 36000            },
      { id: "hundred_hours",  condition: () => total >= 360000           },
      { id: "streak_3",       condition: () => streak >= 3               },
      { id: "streak_7",       condition: () => streak >= 7               },
      { id: "streak_30",      condition: () => streak >= 30              },
      { id: "long_session",   condition: () => longest >= 3600           },
    ];
    const achs = ALL_ACH.filter(a => a.condition()).map(a => a.id);

    const stats = {
      totalFocusSeconds:      total,
      todayFocusSeconds:      todaySecs,
      weekFocusSeconds:       weekSecs,
      monthFocusSeconds:      weekSecs,
      currentStreak:          streak,
      longestStreak:          streak,
      totalSessionsCompleted: completed.length,
      avgSessionDuration:     avg,
      longestSession:         longest,
      totalTasksCompleted:    0,
      achievements:           achs,
      lastCalculated:         new Date().toISOString(),
    };
    try { localStorage.setItem("sa_stats_v1", JSON.stringify(stats)); } catch {}
  }

  function updateDisplay() {
    const m = Math.floor(timeLeft / 60);
    const s = timeLeft % 60;
    if (display) display.textContent = `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    if (ring) {
      const offset = ringCircumference - (timeLeft / totalTime) * ringCircumference;
      ring.style.strokeDashoffset = offset.toString();
    }
  }

  function startTimer() {
    if (isRunning) return;
    isRunning        = true;
    sessionStartTime = Date.now();
    if (startText) startText.textContent = "Pause";
    if (startIcon) startIcon.innerHTML   = `<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>`;
    timerId = setInterval(() => {
      timeLeft--;
      updateDisplay();
      if (timeLeft <= 0) {
        pauseTimer();
        playAlertSound();
        if (currentMode === "pomodoro") recordCompletedSession();
        resetTimer();
        if (statusDisplay) {
          statusDisplay.textContent = "Session Complete!";
          setTimeout(() => {
            if (!isRunning && statusDisplay) {
              statusDisplay.textContent = currentMode === "pomodoro" ? "Focusing" : "Relaxing";
            }
          }, 5000);
        }
      }
    }, 1000);
  }

  function pauseTimer() {
    if (!isRunning) return;
    isRunning = false;
    if (startText) startText.textContent = "Start";
    if (startIcon) startIcon.innerHTML   = `<path d="M8 5v14l11-7z"/>`;
    if (timerId)   { clearInterval(timerId); timerId = null; }
  }

  function resetTimer() {
    pauseTimer();
    timeLeft         = totalTime;
    sessionStartTime = null;
    updateDisplay();
  }

  startBtn?.addEventListener("click", () => isRunning ? pauseTimer() : startTimer());
  resetBtn?.addEventListener("click", resetTimer);

  modeButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      modeButtons.forEach(b => {
        b.classList.remove("bg-primary", "text-white");
        b.classList.add("text-ink-subtle");
      });
      btn.classList.add("bg-primary", "text-white");
      btn.classList.remove("text-ink-subtle");
      const timeValue = parseInt(btn.getAttribute("data-time") || "1500");
      totalTime    = timeValue;
      timeLeft     = timeValue;
      currentMode  = (btn.id === "mode-pomodoro" ? "pomodoro" : btn.id === "mode-short" ? "short" : "long") as TimerMode;
      if (statusDisplay) statusDisplay.textContent = currentMode === "pomodoro" ? "Focusing" : "Relaxing";
      resetTimer();
    });
  });

  // ── Minimize toggle ─────────────────────────────────────────────
  const widget      = document.getElementById("timer-widget");
  const minimizeBtn = widget?.querySelector(".minimize-btn");
  minimizeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    widget?.classList.toggle("is-minimized");
  });

  updateDisplay();
</script>
