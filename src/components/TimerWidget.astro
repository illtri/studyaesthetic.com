---

<div
  id="timer-widget"
  class="widget-island glass rounded-xl z-40 edge-highlight"
  data-widget-key="timer"
  data-default-x="80"
  data-default-y="80"
  style="width: 320px;"
>
  <!-- Widget Handle -->
  <div class="widget-handle flex items-center justify-between px-4 pt-4 pb-3 border-b border-hairline cursor-grab select-none">
    <div class="flex items-center gap-2 text-ink-subtle">
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-xs font-semibold uppercase tracking-wider font-sans">Pomodoro Timer</span>
    </div>
    <button
      class="minimize-btn text-ink-subtle hover:text-ink hover:bg-surface-2 p-1 rounded transition cursor-pointer"
      aria-label="Minimize timer widget"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>
      </svg>
    </button>
  </div>

  <!-- Widget Body -->
  <div class="widget-body px-4 pb-4 pt-4 flex flex-col items-center">
    <!-- Mode Selectors -->
    <div class="flex gap-1 p-1 bg-surface-2/60 border border-hairline rounded-lg w-full mb-5">
      <button id="mode-pomodoro" data-mode="pomodoro" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium bg-primary text-white cursor-pointer transition flex items-center justify-center gap-1.5" data-time="1500">
        <span>Pomodoro</span>
        <span class="mode-running-dot hidden w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
      </button>
      <button id="mode-short" data-mode="short" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition flex items-center justify-center gap-1.5" data-time="300">
        <span>Short Break</span>
        <span class="mode-running-dot hidden w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
      </button>
      <button id="mode-long" data-mode="long" class="timer-mode-btn flex-1 text-center py-1.5 rounded text-xs font-medium text-ink-subtle hover:text-ink cursor-pointer transition flex items-center justify-center gap-1.5" data-time="900">
        <span>Long Break</span>
        <span class="mode-running-dot hidden w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Countdown with SVG Ring -->
    <div class="relative w-44 h-44 flex items-center justify-center mb-5">
      <svg class="w-full h-full -rotate-90" aria-hidden="true">
        <circle cx="88" cy="88" r="80" stroke="var(--color-hairline)" stroke-width="4" fill="transparent"/>
        <circle
          id="timer-ring"
          cx="88" cy="88" r="80"
          stroke="var(--color-primary)"
          stroke-width="5"
          fill="transparent"
          stroke-dasharray="502.65"
          stroke-dashoffset="0"
          stroke-linecap="round"
          style="transition: stroke-dashoffset 0.9s linear;"
        />
      </svg>
      <div class="absolute flex flex-col items-center justify-center">
        <span id="timer-display" class="font-mono text-3xl font-bold tracking-tight text-ink" aria-live="polite" aria-atomic="true">25:00</span>
        <span id="timer-status" class="text-[10px] text-ink-subtle font-sans tracking-wide uppercase mt-1">Focusing</span>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-3 w-full">
      <button id="timer-start" class="flex-1 bg-primary hover:bg-primary-hover active:bg-primary-focus text-white font-medium text-sm py-2 rounded-md transition cursor-pointer flex items-center justify-center gap-1.5">
        <svg id="start-icon" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span id="start-text">Start</span>
      </button>
      <button id="timer-reset" class="bg-surface-2 hover:bg-surface-3 border border-hairline text-ink font-medium text-sm px-4 py-2 rounded-md transition cursor-pointer">
        Reset
      </button>
    </div>
  </div>
</div>

<script>
  import {
    type TimerMode,
    type MultiModeTimerState,
    type SessionRecord,
    type ActivityDay,
    type StudyStats,
    createInitialTimerState,
    startModeTimer,
    pauseModeTimer,
    resetModeTimer,
    tickRunningTimers,
    normalizeAndCalculateStats,
    localDateKey,
    getDaySeconds,
  } from "../utils/studyStats";

  let timerStates: MultiModeTimerState = createInitialTimerState();
  let activeMode: TimerMode = "pomodoro";
  let masterInterval: ReturnType<typeof setInterval> | null = null;
  let statusTimeout: ReturnType<typeof setTimeout> | null = null;

  const display       = document.getElementById("timer-display");
  const statusDisplay = document.getElementById("timer-status");
  const startBtn      = document.getElementById("timer-start");
  const resetBtn      = document.getElementById("timer-reset");
  const startText     = document.getElementById("start-text");
  const startIcon     = document.getElementById("start-icon");
  const ring          = document.getElementById("timer-ring") as unknown as SVGCircleElement;
  const modeButtons   = document.querySelectorAll<HTMLButtonElement>(".timer-mode-btn");
  const ringCircumference = 502.65;

  function playAlertSound() {
    try {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc1 = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc1.type = "sine";
      osc1.frequency.setValueAtTime(523.25, audioCtx.currentTime);
      osc2.type = "sine";
      osc2.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.15);
      gain.gain.setValueAtTime(0, audioCtx.currentTime);
      gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.2);
      osc1.connect(gain); osc2.connect(gain); gain.connect(audioCtx.destination);
      osc1.start(); osc2.start(audioCtx.currentTime + 0.15);
      osc1.stop(audioCtx.currentTime + 1.2); osc2.stop(audioCtx.currentTime + 1.2);
    } catch (e) { console.warn("AudioContext chime failed:", e); }
  }

  function readStorageJson<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch {
      return fallback;
    }
  }

  function persistFocusTick(secondsEarned: number): StudyStats | null {
    if (secondsEarned <= 0) return null;
    try {
      const todayKey = localDateKey();
      const sessions = readStorageJson<SessionRecord[]>("sa_sessions_v1", []);
      const activity = readStorageJson<Record<string, Partial<ActivityDay>>>("sa_activity_v1", {});
      const prevStats = readStorageJson<Partial<StudyStats> | null>("sa_stats_v1", null);

      const currentDay = activity[todayKey] || {
        date: todayKey,
        focusSeconds: 0,
        focusMinutes: 0,
        sessionsCompleted: 0,
        tasksCompleted: 0,
        backgroundsUsed: [],
        widgetsUsed: [],
      };

      const nextSecs = getDaySeconds(currentDay) + secondsEarned;
      activity[todayKey] = {
        ...currentDay,
        date: todayKey,
        focusSeconds: nextSecs,
        focusMinutes: Math.round((nextSecs / 60) * 10) / 10,
      };

      const normalized = normalizeAndCalculateStats(sessions, activity, prevStats);
      localStorage.setItem("sa_activity_v1", JSON.stringify(normalized.activity));
      localStorage.setItem("sa_stats_v1", JSON.stringify(normalized.stats));
      return normalized.stats;
    } catch {
      return null;
    }
  }

  function recordCompletedSession(mode: TimerMode, duration: number) {
    const endTime = new Date().toISOString();
    const startTime = new Date(Date.now() - duration * 1000).toISOString();

    try {
      const sessions = readStorageJson<SessionRecord[]>("sa_sessions_v1", []);
      const userProfile = readStorageJson<{ id?: string }>("sa_user_profile_v1", {});
      sessions.push({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
        userId: userProfile.id || "anon",
        startTime,
        endTime,
        duration,
        mode,
        completed: true,
      });
      const trimmedSessions = sessions.slice(-500);
      localStorage.setItem("sa_sessions_v1", JSON.stringify(trimmedSessions));

      const todayKey = localDateKey();
      const activity = readStorageJson<Record<string, Partial<ActivityDay>>>("sa_activity_v1", {});
      const prevStats = readStorageJson<Partial<StudyStats> | null>("sa_stats_v1", null);

      if (!activity[todayKey]) {
        activity[todayKey] = {
          date: todayKey,
          focusSeconds: 0,
          focusMinutes: 0,
          sessionsCompleted: 0,
          tasksCompleted: 0,
          backgroundsUsed: [],
          widgetsUsed: [],
        };
      }

      if (mode === "pomodoro") {
        activity[todayKey].sessionsCompleted = Number(activity[todayKey].sessionsCompleted || 0) + 1;
      }

      const normalized = normalizeAndCalculateStats(trimmedSessions, activity, prevStats);
      localStorage.setItem("sa_activity_v1", JSON.stringify(normalized.activity));
      localStorage.setItem("sa_stats_v1", JSON.stringify(normalized.stats));

      document.dispatchEvent(new CustomEvent("study-stats-updated", {
        detail: { stats: normalized.stats },
      }));
    } catch {}

    document.dispatchEvent(new CustomEvent("study-session-complete", {
      detail: { duration, mode, endTime },
    }));
  }

  function defaultStatusText(mode: TimerMode): string {
    const state = timerStates[mode];
    if (!state.isRunning && state.timeLeft < state.totalTime) return "Paused";
    return mode === "pomodoro" ? "Focusing" : "Relaxing";
  }

  function updateDisplay() {
    const current = timerStates[activeMode];
    const m = Math.floor(current.timeLeft / 60);
    const s = current.timeLeft % 60;
    if (display) {
      display.textContent = `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    }
    if (ring) {
      const ratio = current.totalTime > 0 ? current.timeLeft / current.totalTime : 0;
      const offset = ringCircumference - ratio * ringCircumference;
      ring.style.strokeDashoffset = offset.toString();
    }
    if (startText) {
      startText.textContent = current.isRunning ? "Pause" : "Start";
    }
    if (startIcon) {
      startIcon.innerHTML = current.isRunning
        ? `<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>`
        : `<path d="M8 5v14l11-7z"/>`;
    }
    if (statusDisplay && !statusTimeout) {
      statusDisplay.textContent = defaultStatusText(activeMode);
    }

    modeButtons.forEach((btn) => {
      const btnMode = btn.dataset.mode as TimerMode;
      const isSelected = btnMode === activeMode;
      btn.classList.toggle("bg-primary", isSelected);
      btn.classList.toggle("text-white", isSelected);
      btn.classList.toggle("text-ink-subtle", !isSelected);

      const dot = btn.querySelector(".mode-running-dot");
      if (dot) {
        dot.classList.toggle("hidden", !timerStates[btnMode]?.isRunning);
      }
    });
  }

  function hasAnyRunningTimer(): boolean {
    return (["pomodoro", "short", "long"] as TimerMode[]).some((m) => timerStates[m].isRunning);
  }

  function ensureMasterLoop() {
    const anyRunning = hasAnyRunningTimer();
    if (anyRunning && !masterInterval) {
      masterInterval = setInterval(() => {
        const result = tickRunningTimers(timerStates);
        timerStates = result.nextState;

        if (result.focusSecondsEarned > 0) {
          const stats = persistFocusTick(result.focusSecondsEarned);
          if (stats) {
            document.dispatchEvent(new CustomEvent("study-stats-updated", { detail: { stats } }));
          }
        }

        if (result.completedModes.length > 0) {
          playAlertSound();
          for (const done of result.completedModes) {
            recordCompletedSession(done.mode, done.duration);
          }
          if (statusDisplay) {
            statusDisplay.textContent = "Session Complete!";
            if (statusTimeout) clearTimeout(statusTimeout);
            statusTimeout = setTimeout(() => {
              statusTimeout = null;
              if (statusDisplay) {
                statusDisplay.textContent = defaultStatusText(activeMode);
              }
            }, 5000);
          }
        }

        updateDisplay();
        ensureMasterLoop();
      }, 1000);
    } else if (!anyRunning && masterInterval) {
      clearInterval(masterInterval);
      masterInterval = null;
    }
  }

  function toggleActiveTimer() {
    const current = timerStates[activeMode];
    if (statusTimeout) {
      clearTimeout(statusTimeout);
      statusTimeout = null;
    }

    if (current.isRunning) {
      timerStates = pauseModeTimer(timerStates, activeMode);
      if (activeMode === "pomodoro") {
        document.dispatchEvent(new CustomEvent("study-session-pause"));
      }
    } else {
      timerStates = startModeTimer(timerStates, activeMode);
      if (activeMode === "pomodoro") {
        document.dispatchEvent(new CustomEvent("study-session-start", { detail: { mode: activeMode } }));
      }
    }

    updateDisplay();
    ensureMasterLoop();
  }

  function resetActiveTimer() {
    if (statusTimeout) {
      clearTimeout(statusTimeout);
      statusTimeout = null;
    }
    const wasRunning = timerStates[activeMode].isRunning;
    timerStates = resetModeTimer(timerStates, activeMode);
    if (wasRunning && activeMode === "pomodoro") {
      document.dispatchEvent(new CustomEvent("study-session-pause"));
    }
    updateDisplay();
    ensureMasterLoop();
  }

  startBtn?.addEventListener("click", toggleActiveTimer);
  resetBtn?.addEventListener("click", resetActiveTimer);

  modeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const nextMode = (btn.dataset.mode || "pomodoro") as TimerMode;
      if (statusTimeout) {
        clearTimeout(statusTimeout);
        statusTimeout = null;
      }
      activeMode = nextMode;
      updateDisplay();
    });
  });

  // ── Minimize toggle ─────────────────────────────────────────────
  const widget      = document.getElementById("timer-widget");
  const minimizeBtn = widget?.querySelector(".minimize-btn");
  minimizeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    widget?.classList.toggle("is-minimized");
  });

  updateDisplay();
</script>
