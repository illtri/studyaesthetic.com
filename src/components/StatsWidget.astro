---
// e:/ARUNAV WORKS/studyaesthetic.com/src/components/StatsWidget.astro
---

<div
  id="stats-widget"
  class="widget-island glass rounded-xl z-40 edge-highlight"
  data-widget-key="stats"
  data-default-x="760"
  data-default-y="480"
  style="width: 360px;"
>
  <!-- Handle -->
  <div class="widget-handle flex items-center justify-between px-4 pt-4 pb-3 border-b border-hairline cursor-grab select-none">
    <div class="flex items-center gap-2 text-ink-subtle">
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
      </svg>
      <span class="text-xs font-semibold uppercase tracking-wider font-sans">Study Statistics</span>
    </div>
    <div class="flex items-center gap-1.5">
      <!-- Tab switcher -->
      <div class="flex gap-0.5 bg-surface-2/60 rounded-md p-0.5 border border-hairline">
        <button id="stats-tab-overview" class="stats-tab active-tab px-2 py-0.5 rounded text-[10px] font-semibold transition cursor-pointer" aria-pressed="true">Overview</button>
        <button id="stats-tab-heatmap" class="stats-tab px-2 py-0.5 rounded text-[10px] font-semibold transition cursor-pointer" aria-pressed="false">Activity</button>
        <button id="stats-tab-achievements" class="stats-tab px-2 py-0.5 rounded text-[10px] font-semibold transition cursor-pointer" aria-pressed="false">Badges</button>
      </div>
      <button class="minimize-btn text-ink-subtle hover:text-ink hover:bg-surface-2 p-1 rounded transition cursor-pointer" aria-label="Minimize stats widget">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Body -->
  <div class="widget-body px-4 pb-4 pt-3 flex flex-col">

    <!-- ── Overview Tab ───────────────────────────────── -->
    <div id="stats-panel-overview" class="stats-panel">

      <!-- Today's streak banner -->
      <div id="streak-banner" class="flex items-center gap-2 px-3 py-2 bg-primary/10 border border-primary/20 rounded-lg mb-3 hidden">
        <span class="text-lg" aria-hidden="true">🔥</span>
        <div>
          <p class="text-xs font-semibold text-ink" id="streak-text">0 day streak</p>
          <p class="text-[10px] text-ink-subtle">Keep it going!</p>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 gap-2 mb-3">

        <!-- Today's Focus -->
        <div class="stat-card bg-surface-2/50 border border-hairline rounded-lg p-3 flex flex-col gap-1">
          <div class="flex items-center gap-1.5 text-ink-subtle">
            <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07l-.71.71M6.34 17.66l-.71.71m12.02 0l-.71-.71M6.34 6.34l-.71-.71"/>
            </svg>
            <span class="text-[9px] font-semibold uppercase tracking-wide">Today</span>
          </div>
          <p id="stat-today" class="font-mono text-lg font-bold text-ink leading-none">0s</p>
          <p class="text-[9px] text-ink-subtle">focus time</p>
        </div>

        <!-- Weekly Focus -->
        <div class="stat-card bg-surface-2/50 border border-hairline rounded-lg p-3 flex flex-col gap-1">
          <div class="flex items-center gap-1.5 text-ink-subtle">
            <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="text-[9px] font-semibold uppercase tracking-wide">This Week</span>
          </div>
          <p id="stat-week" class="font-mono text-lg font-bold text-ink leading-none">0s</p>
          <p class="text-[9px] text-ink-subtle">focus time</p>
        </div>

        <!-- Total Sessions -->
        <div class="stat-card bg-surface-2/50 border border-hairline rounded-lg p-3 flex flex-col gap-1">
          <div class="flex items-center gap-1.5 text-ink-subtle">
            <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span class="text-[9px] font-semibold uppercase tracking-wide">Sessions</span>
          </div>
          <p id="stat-sessions" class="font-mono text-lg font-bold text-ink leading-none">0</p>
          <p class="text-[9px] text-ink-subtle">completed</p>
        </div>

        <!-- Longest Session -->
        <div class="stat-card bg-surface-2/50 border border-hairline rounded-lg p-3 flex flex-col gap-1">
          <div class="flex items-center gap-1.5 text-ink-subtle">
            <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span class="text-[9px] font-semibold uppercase tracking-wide">Best Session</span>
          </div>
          <p id="stat-longest" class="font-mono text-lg font-bold text-ink leading-none">—</p>
          <p class="text-[9px] text-ink-subtle">longest focus</p>
        </div>
      </div>

      <!-- Total lifetime stat -->
      <div class="flex items-center justify-between px-3 py-2 bg-surface-1/60 border border-hairline rounded-lg">
        <div class="flex items-center gap-2">
          <span class="text-base" aria-hidden="true">📚</span>
          <div>
            <p class="text-[10px] text-ink-subtle">Total Study Time</p>
            <p id="stat-total" class="font-mono text-sm font-bold text-ink">0s</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-[10px] text-ink-subtle">Avg. Session</p>
          <p id="stat-avg" class="font-mono text-sm font-bold text-ink">—</p>
        </div>
      </div>
    </div>

    <!-- ── Activity Heatmap Tab ──────────────────────────── -->
    <div id="stats-panel-heatmap" class="stats-panel hidden">
      <p class="text-[10px] text-ink-subtle uppercase tracking-wider font-semibold mb-2">7-Day Activity</p>

      <!-- Day labels -->
      <div id="heatmap-labels" class="grid grid-cols-7 gap-1 mb-1"></div>
      <!-- Heatmap cells -->
      <div id="heatmap-grid" class="grid grid-cols-7 gap-1 justify-items-center mb-3"></div>

      <!-- Legend -->
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[9px] text-ink-subtle">Less</span>
        <div class="heatmap-cell"></div>
        <div class="heatmap-cell" data-level="1"></div>
        <div class="heatmap-cell" data-level="2"></div>
        <div class="heatmap-cell" data-level="3"></div>
        <div class="heatmap-cell" data-level="4"></div>
        <div class="heatmap-cell" data-level="5"></div>
        <span class="text-[9px] text-ink-subtle">More</span>
      </div>

      <!-- Weekly bar chart -->
      <p class="text-[10px] text-ink-subtle uppercase tracking-wider font-semibold mb-2">Daily Focus (mins)</p>
      <div id="bar-chart" class="flex items-end gap-1.5 h-20 pt-2"></div>
    </div>

    <!-- ── Achievements Tab ──────────────────────────────── -->
    <div id="stats-panel-achievements" class="stats-panel hidden">
      <p class="text-[10px] text-ink-subtle uppercase tracking-wider font-semibold mb-3">
        Achievements <span id="badge-count" class="text-primary"></span>
      </p>
      <div id="achievements-grid" class="grid grid-cols-2 gap-2 max-h-[260px] overflow-y-auto pr-0.5"></div>
    </div>

  </div>
</div>

<style>
  .active-tab {
    background-color: var(--color-surface-1);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
  }
  .stats-tab:not(.active-tab) {
    color: var(--color-ink-subtle);
    background: transparent;
  }
  .stats-tab:not(.active-tab):hover {
    color: var(--color-ink);
    background-color: rgba(255,255,255,0.04);
  }
  .stat-card {
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .stat-card:hover {
    border-color: var(--color-hairline-strong);
    background-color: rgba(20, 21, 22, 0.8);
  }
</style>

<script>
  import {
    type StudyStats,
    type ActivityDay,
    type SessionRecord,
    normalizeAndCalculateStats,
    formatFocusDuration,
    getHeatmapLevel,
    localDateKey,
    getDaySeconds,
  } from "../utils/studyStats";

  // ── Minimize ────────────────────────────────────────────────────
  const widget      = document.getElementById("stats-widget");
  const minimizeBtn = widget?.querySelector(".minimize-btn");
  minimizeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    widget?.classList.toggle("is-minimized");
  });

  // ── Tab system ──────────────────────────────────────────────────
  const tabs   = widget?.querySelectorAll<HTMLButtonElement>(".stats-tab") ?? [];
  const panels = widget?.querySelectorAll<HTMLElement>(".stats-panel") ?? [];

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      const id = tab.id.replace("stats-tab-", "stats-panel-");
      tabs.forEach(t => { t.classList.remove("active-tab"); t.setAttribute("aria-pressed", "false"); });
      panels.forEach(p => p.classList.add("hidden"));
      tab.classList.add("active-tab");
      tab.setAttribute("aria-pressed", "true");
      document.getElementById(id)?.classList.remove("hidden");
      if (id === "stats-panel-heatmap") renderHeatmap();
      if (id === "stats-panel-achievements") renderAchievements();
    });
  });

  // ── Load + normalize stats ──────────────────────────────────────
  function readJson<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch { return fallback; }
  }

  function loadNormalizedStats(): { stats: StudyStats; activity: Record<string, ActivityDay> } {
    const sessions  = readJson<SessionRecord[]>("sa_sessions_v1", []);
    const activity  = readJson<Record<string, Partial<ActivityDay>>>("sa_activity_v1", {});
    const prevStats = readJson<Partial<StudyStats> | null>("sa_stats_v1", null);
    const normalized = normalizeAndCalculateStats(sessions, activity, prevStats);
    try {
      localStorage.setItem("sa_activity_v1", JSON.stringify(normalized.activity));
      localStorage.setItem("sa_stats_v1", JSON.stringify(normalized.stats));
    } catch {}
    return normalized;
  }

  function getStats(): StudyStats {
    return loadNormalizedStats().stats;
  }

  function getActivity(days = 7): ActivityDay[] {
    const { activity } = loadNormalizedStats();
    const result: ActivityDay[] = [];
    for (let i = days - 1; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const key = localDateKey(d);
      result.push(activity[key] || {
        date: key,
        focusSeconds: 0,
        focusMinutes: 0,
        sessionsCompleted: 0,
        tasksCompleted: 0,
        backgroundsUsed: [],
        widgetsUsed: [],
      });
    }
    return result;
  }

  function renderOverview(statsOverride?: StudyStats) {
    const stats = statsOverride || getStats();

    const todayEl    = document.getElementById("stat-today");
    const weekEl     = document.getElementById("stat-week");
    const sessEl     = document.getElementById("stat-sessions");
    const longEl     = document.getElementById("stat-longest");
    const totalEl    = document.getElementById("stat-total");
    const avgEl      = document.getElementById("stat-avg");
    const streakBn   = document.getElementById("streak-banner");
    const streakTxt  = document.getElementById("streak-text");

    if (todayEl)   todayEl.textContent   = formatFocusDuration(stats.todayFocusSeconds);
    if (weekEl)    weekEl.textContent    = formatFocusDuration(stats.weekFocusSeconds);
    if (sessEl)    sessEl.textContent    = stats.totalSessionsCompleted.toString();
    if (longEl)    longEl.textContent    = stats.longestSession > 0 ? formatFocusDuration(stats.longestSession) : "—";
    if (totalEl)   totalEl.textContent   = formatFocusDuration(stats.totalFocusSeconds);
    if (avgEl)     avgEl.textContent     = stats.avgSessionDuration > 0 ? formatFocusDuration(stats.avgSessionDuration) : "—";

    if (streakBn && streakTxt) {
      if (stats.currentStreak > 0) {
        streakBn.classList.remove("hidden");
        streakTxt.textContent = `${stats.currentStreak} day${stats.currentStreak > 1 ? "s" : ""} streak`;
      } else {
        streakBn.classList.add("hidden");
      }
    }
  }

  function renderHeatmap() {
    const data       = getActivity(7);
    const labelsEl   = document.getElementById("heatmap-labels");
    const gridEl     = document.getElementById("heatmap-grid");
    const barChartEl = document.getElementById("bar-chart");
    if (!labelsEl || !gridEl || !barChartEl) return;

    const days    = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const maxSecs = Math.max(...data.map(d => getDaySeconds(d)), 60);

    labelsEl.innerHTML   = "";
    gridEl.innerHTML     = "";
    barChartEl.innerHTML = "";

    data.forEach(day => {
      const date  = new Date(day.date + "T12:00:00");
      const secs  = getDaySeconds(day);
      const mins  = Math.round((secs / 60) * 10) / 10;
      const level = getHeatmapLevel(secs);

      // Day letter label
      const label = document.createElement("div");
      label.textContent = days[date.getDay()].slice(0, 1);
      label.className   = "text-center text-[9px] text-ink-subtle font-mono";
      labelsEl.appendChild(label);

      // Centered heatmap square
      const cell = document.createElement("div");
      cell.className = "heatmap-cell mx-auto";
      if (level > 0) cell.setAttribute("data-level", level.toString());
      cell.title = `${day.date}: ${formatFocusDuration(secs)}`;
      gridEl.appendChild(cell);

      // Bar column with full height track
      const barWrap = document.createElement("div");
      barWrap.className = "flex-1 h-full flex flex-col items-center gap-1";

      const barTrack = document.createElement("div");
      barTrack.className = "w-full flex-1 flex items-end justify-center";

      const bar = document.createElement("div");
      const pct = secs > 0 ? Math.max((secs / maxSecs) * 100, 10) : 0;
      bar.className = "w-full max-w-[22px] rounded-t-sm transition-all duration-300";
      bar.style.height = secs > 0 ? `${pct}%` : "4px";
      bar.style.background = level > 0
        ? `rgba(94, 106, 210, ${0.35 + level * 0.13})`
        : "var(--color-surface-2)";
      bar.style.border = level > 0
        ? "1px solid rgba(130, 143, 255, 0.35)"
        : "1px solid var(--color-hairline)";
      bar.title = `${day.date}: ${mins}m (${formatFocusDuration(secs)})`;

      const dayLbl = document.createElement("span");
      dayLbl.className   = "text-[8px] text-ink-subtle font-mono shrink-0";
      dayLbl.textContent = days[date.getDay()].slice(0, 1);

      barTrack.appendChild(bar);
      barWrap.appendChild(barTrack);
      barWrap.appendChild(dayLbl);
      barChartEl.appendChild(barWrap);
    });
  }

  function renderAchievements() {
    const stats   = getStats();
    const gridEl  = document.getElementById("achievements-grid");
    const countEl = document.getElementById("badge-count");
    if (!gridEl) return;

    const ACHIEVEMENTS = [
      { id: "first_session",  title: "First Focus",     icon: "🎯", desc: "Complete 1 session" },
      { id: "ten_sessions",   title: "Getting Serious", icon: "🔟", desc: "Complete 10 sessions" },
      { id: "fifty_sessions", title: "Study Master",    icon: "🏆", desc: "Complete 50 sessions" },
      { id: "one_hour",       title: "In the Zone",     icon: "⏱️", desc: "1 hour total focus" },
      { id: "ten_hours",      title: "Deep Worker",     icon: "🧠", desc: "10 hours total focus" },
      { id: "hundred_hours",  title: "Scholar",         icon: "📚", desc: "100 hours total focus" },
      { id: "streak_3",       title: "On a Roll",       icon: "🔥", desc: "3 day streak" },
      { id: "streak_7",       title: "Weekly Warrior",  icon: "⚡", desc: "7 day streak" },
      { id: "streak_30",      title: "Unstoppable",     icon: "🌟", desc: "30 day streak" },
      { id: "long_session",   title: "Marathon",        icon: "🏃", desc: "Session > 1 hour" },
    ];

    const unlocked = stats?.achievements || [];
    if (countEl) countEl.textContent = `${unlocked.length}/${ACHIEVEMENTS.length}`;
    gridEl.innerHTML = "";

    ACHIEVEMENTS.forEach(a => {
      const isUnlocked = unlocked.includes(a.id);
      const badge = document.createElement("div");
      badge.className = `achievement-badge flex items-center gap-2 p-2 rounded-lg border cursor-default text-left ${isUnlocked
        ? "bg-primary/15 border-primary/40"
        : "bg-surface-2/60 border-hairline-strong/60 locked"}`;
      badge.title = a.desc;
      badge.setAttribute("aria-label", `${a.title}: ${isUnlocked ? "Unlocked" : "Locked"} — ${a.desc}`);
      badge.innerHTML = `
        <span class="badge-icon text-lg shrink-0" aria-hidden="true">${a.icon}</span>
        <div class="min-w-0">
          <p class="text-[11px] font-semibold leading-tight truncate ${isUnlocked ? "text-ink" : "text-ink-muted"}">${a.title}</p>
          <p class="text-[9px] leading-snug text-ink-subtle truncate mt-0.5">${a.desc}</p>
        </div>
      `;
      gridEl.appendChild(badge);
    });
  }

  // ── Supabase helpers (lazy-loaded to keep widget self-contained) ──
  async function getSupabaseModules() {
    try {
      const [{ supabase, isSupabaseConfigured }, { pushStatsToCloud, pullStatsFromCloud, pushActivityToCloud, pullActivityFromCloud }] =
        await Promise.all([
          import("../lib/supabase"),
          import("../lib/supabaseSync"),
        ]);
      return { supabase, isSupabaseConfigured, pushStatsToCloud, pullStatsFromCloud, pushActivityToCloud, pullActivityFromCloud };
    } catch { return null; }
  }

  const LOCAL_ONLY_PROVIDERS = ["anonymous", "demo"];

  function getCurrentUser(): { id: string; authProvider: string } | null {
    try {
      const raw = localStorage.getItem("sa_user_profile_v1");
      return raw ? JSON.parse(raw) : null;
    } catch { return null; }
  }

  async function syncStatsToCloud() {
    const user = getCurrentUser();
    if (!user || LOCAL_ONLY_PROVIDERS.includes(user.authProvider)) return;
    const mods = await getSupabaseModules();
    if (!mods || !mods.isSupabaseConfigured) return;
    const stats = getStats();
    if (stats) {
      mods.pushStatsToCloud(user.id, stats as any).catch(() => {});
    }
    try {
      const rawAct = localStorage.getItem("sa_activity_v1");
      if (rawAct) {
        const activity = JSON.parse(rawAct);
        mods.pushActivityToCloud(user.id, activity).catch(() => {});
      }
    } catch {}
  }

  async function pullAndMergeFromCloud(userId: string) {
    const mods = await getSupabaseModules();
    if (!mods || !mods.isSupabaseConfigured) return;

    const cloudStats = await mods.pullStatsFromCloud(userId);
    if (cloudStats) {
      const local = getStats();
      const merged = {
        ...(local || {}),
        ...cloudStats,
        totalFocusSeconds:      Math.max(local?.totalFocusSeconds || 0,      cloudStats.totalFocusSeconds || 0),
        totalSessionsCompleted: Math.max(local?.totalSessionsCompleted || 0,  cloudStats.totalSessionsCompleted || 0),
        longestSession:         Math.max(local?.longestSession || 0,          cloudStats.longestSession || 0),
        longestStreak:          Math.max(local?.longestStreak || 0,           cloudStats.longestStreak || 0),
        achievements:           [...new Set([...(local?.achievements || []), ...(cloudStats.achievements || [])])],
      };
      try { localStorage.setItem("sa_stats_v1", JSON.stringify(merged)); } catch {}
    }

    const cloudActivity = await mods.pullActivityFromCloud(userId);
    if (cloudActivity) {
      try {
        const rawLocal = localStorage.getItem("sa_activity_v1");
        const localActivity: Record<string, any> = rawLocal ? JSON.parse(rawLocal) : {};
        for (const [date, dayData] of Object.entries(cloudActivity)) {
          const cloudDay = dayData as any;
          const localDay = localActivity[date];
          if (!localDay) {
            localActivity[date] = cloudDay;
          } else {
            const mergedSecs = Math.max(getDaySeconds(localDay), getDaySeconds(cloudDay));
            localActivity[date] = {
              ...localDay,
              focusSeconds:      mergedSecs,
              focusMinutes:      Math.round((mergedSecs / 60) * 10) / 10,
              sessionsCompleted: Math.max(localDay.sessionsCompleted || 0, cloudDay.sessionsCompleted || 0),
            };
          }
        }
        localStorage.setItem("sa_activity_v1", JSON.stringify(localActivity));
      } catch {}
    }

    // Re-normalize merged stats so today <= week <= total is always satisfied
    const { stats } = loadNormalizedStats();
    renderOverview(stats);
    const heatmapPanel = document.getElementById("stats-panel-heatmap");
    if (heatmapPanel && !heatmapPanel.classList.contains("hidden")) renderHeatmap();
    const achPanel = document.getElementById("stats-panel-achievements");
    if (achPanel && !achPanel.classList.contains("hidden")) renderAchievements();
  }

  function refreshActivePanels(statsOverride?: StudyStats) {
    renderOverview(statsOverride);
    const heatmapPanel = document.getElementById("stats-panel-heatmap");
    if (heatmapPanel && !heatmapPanel.classList.contains("hidden")) renderHeatmap();
    const achPanel = document.getElementById("stats-panel-achievements");
    if (achPanel && !achPanel.classList.contains("hidden")) renderAchievements();
  }

  // ── Live synced updates from TimerWidget ────────────────────────
  document.addEventListener("study-stats-updated", (e: any) => {
    refreshActivePanels(e.detail?.stats);
  });

  document.addEventListener("study-session-pause", () => {
    refreshActivePanels();
    syncStatsToCloud();
  });

  document.addEventListener("study-session-complete", () => {
    refreshActivePanels();
    syncStatsToCloud();
  });

  // ── Auth state changes (login / logout) ─────────────────────────
  document.addEventListener("auth-state-changed", async (e: any) => {
    const { loggedIn, user } = e.detail || {};
    if (loggedIn && user?.id && !LOCAL_ONLY_PROVIDERS.includes(user.authProvider || "")) {
      await pullAndMergeFromCloud(user.id);
    } else {
      refreshActivePanels();
    }
  });

  // ── Initial render ──────────────────────────────────────────────
  renderOverview();

  (async () => {
    const user = getCurrentUser();
    if (user && !LOCAL_ONLY_PROVIDERS.includes(user.authProvider)) {
      await pullAndMergeFromCloud(user.id);
    }
  })();
</script>
