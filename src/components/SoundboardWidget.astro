---
import { getSoundsFromDb } from '../utils/MediaDatabase';

const ambientSounds = await getSoundsFromDb();
const soundCategories = ['All', 'Music', 'Nature', 'Ambience', 'Focus'] as const;
---

<div
  id="soundboard-widget"
  class="widget-island glass rounded-xl z-40 edge-highlight"
  data-widget-key="sounds"
  data-default-x="420"
  data-default-y="80"
  style="width: 320px;"
>
  <!-- Handle -->
  <div class="widget-handle flex items-center justify-between px-4 pt-4 pb-3 border-b border-hairline cursor-grab select-none">
    <div class="flex items-center gap-2 text-ink-subtle">
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
      </svg>
      <span class="text-xs font-semibold uppercase tracking-wider font-sans">Ambient Mixer</span>
      <span class="text-[10px] font-mono text-ink-tertiary ml-1">({ambientSounds.length})</span>
    </div>
    <button class="minimize-btn text-ink-subtle hover:text-ink hover:bg-surface-2 p-1 rounded transition cursor-pointer" aria-label="Minimize sounds widget">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"/>
      </svg>
    </button>
  </div>

  <!-- Body -->
  <div class="widget-body px-4 pb-4 pt-3.5 flex flex-col">
    <!-- Guest Lock Notice Banner (shown only when signed out) -->
    <button
      id="soundboard-guest-banner"
      type="button"
      class="hidden mb-2.5 w-full px-2.5 py-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 border border-primary/25 text-[10px] font-medium text-ink-muted flex items-center justify-between transition cursor-pointer"
    >
      <span class="flex items-center gap-1.5">
        <span>🔒</span>
        <span>10 of 12 tracks locked in Guest Mode</span>
      </span>
      <span class="text-primary-hover font-semibold underline">Unlock All</span>
    </button>

    <!-- Quick Presets -->
    <div class="grid grid-cols-3 gap-1.5 mb-2.5">
      <button id="preset-study" data-preset-label="Study" class="preset-btn text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Study</button>
      <button id="preset-rain"  data-preset-label="Rainy" class="preset-btn text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Rainy</button>
      <button id="preset-cafe"  data-preset-label="Cafe"  class="preset-btn text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Cafe</button>
      <button id="preset-piano" data-preset-label="Piano" class="preset-btn text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Piano</button>
      <button id="preset-ocean" data-preset-label="Ocean" class="preset-btn text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Ocean</button>
      <button id="preset-reset" class="text-[10px] font-semibold py-1.5 rounded bg-surface-2 text-ink-subtle hover:text-ink hover:bg-surface-3 transition cursor-pointer">Clear</button>
    </div>

    <!-- Category filter -->
    <div class="flex gap-1 overflow-x-auto pb-2 mb-2 border-b border-hairline/60 whitespace-nowrap" style="scrollbar-width:none;">
      {soundCategories.map((cat, idx) => (
        <button
          type="button"
          class={`sound-cat-tab px-2.5 py-1 rounded-full text-[10px] font-medium cursor-pointer transition shrink-0 ${idx === 0 ? "bg-primary text-white" : "bg-surface-2 text-ink-subtle hover:text-ink"}`}
          data-sound-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Sound Sliders (scrollable compact list) -->
    <div id="sound-sliders-list" class="space-y-2.5 mb-3 max-h-[268px] overflow-y-auto pr-1">
      {ambientSounds.map(sound => (
        <div
          class="sound-row flex items-center gap-3 bg-surface-2/30 border border-hairline/50 p-2 rounded-lg transition"
          data-sound-id={sound.id}
          data-sound-category={sound.category}
        >
          <audio id={`audio-${sound.id}`} src={sound.url} loop preload="none"></audio>
          <button
            type="button"
            class="sound-toggle-btn relative w-8 h-8 rounded-md bg-surface-2 hover:bg-surface-3 flex items-center justify-center text-sm transition cursor-pointer shrink-0"
            data-sound-id={sound.id}
            aria-label={`Toggle ${sound.name}`}
          >
            <span>{sound.icon}</span>
          </button>
          <div class="flex-1 flex flex-col min-w-0">
            <div class="flex justify-between items-center mb-1 gap-2">
              <span class="text-xs font-medium text-ink-muted truncate">{sound.name}</span>
              <span class="sound-value-label text-[10px] font-mono text-ink-subtle shrink-0">0%</span>
            </div>
            <input
              type="range" min="0" max="100" value="0"
              class="sound-slider w-full accent-primary h-1 bg-hairline rounded-lg appearance-none cursor-pointer"
              data-sound-id={sound.id}
              aria-label={`${sound.name} volume`}
            />
          </div>
        </div>
      ))}
    </div>

    <!-- Master Control -->
    <div class="flex items-center justify-between pt-3 border-t border-hairline">
      <button id="soundboard-mute" class="text-xs font-semibold text-ink-subtle hover:text-ink transition cursor-pointer flex items-center gap-1.5" aria-label="Mute all sounds">
        <svg id="mute-icon" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
        </svg>
        <span id="mute-text">Mute All</span>
      </button>
      <span class="text-[10px] font-mono text-ink-tertiary">Royalty-Free</span>
      <button id="soundboard-stop" class="text-xs font-semibold text-ink-subtle hover:text-ink transition cursor-pointer">Stop All</button>
    </div>
  </div>
</div>

<style>
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-primary); cursor: pointer;
  }
  input[type="range"]::-moz-range-thumb {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-primary); cursor: pointer; border: none;
  }
</style>

<script>
  import { canAccessSound, isAuthenticatedProfile } from '../utils/authHelper';

  function isUserSignedIn(): boolean {
    try {
      const raw = localStorage.getItem("sa_user_profile_v1");
      if (!raw) return false;
      return isAuthenticatedProfile(JSON.parse(raw));
    } catch {
      return false;
    }
  }

  function promptSoundSignIn() {
    document.dispatchEvent(
      new CustomEvent("open-auth-modal", {
        detail: { reason: "Sign in to unlock all 12 music & ambient soundtracks and custom presets." },
      })
    );
  }

  const widget = document.getElementById("soundboard-widget");
  const minimizeBtn = widget?.querySelector(".minimize-btn");
  minimizeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    widget?.classList.toggle("is-minimized");
  });

  const guestBanner  = document.getElementById("soundboard-guest-banner");
  const presetBtns   = document.querySelectorAll<HTMLButtonElement>(".preset-btn");
  const soundSliders = document.querySelectorAll(".sound-slider") as NodeListOf<HTMLInputElement>;
  const toggleBtns   = document.querySelectorAll(".sound-toggle-btn") as NodeListOf<HTMLButtonElement>;
  const catTabs      = document.querySelectorAll<HTMLButtonElement>(".sound-cat-tab");
  const soundRows    = document.querySelectorAll<HTMLElement>(".sound-row");
  const muteBtn  = document.getElementById("soundboard-mute");
  const muteText = document.getElementById("mute-text");
  const muteIcon = document.getElementById("mute-icon");
  const stopBtn  = document.getElementById("soundboard-stop");

  let isMuted = false;
  const audioStates: Record<string, { audio: HTMLAudioElement; isPlaying: boolean; volume: number }> = {};

  soundSliders.forEach(slider => {
    const id = slider.getAttribute("data-sound-id") || "";
    const audio = document.getElementById(`audio-${id}`) as HTMLAudioElement;
    if (audio) {
      audio.volume = 0;
      audioStates[id] = { audio, isPlaying: false, volume: 0 };
    }
  });

  guestBanner?.addEventListener("click", () => {
    promptSoundSignIn();
  });

  function syncSoundLocks() {
    const signedIn = isUserSignedIn();
    if (guestBanner) {
      guestBanner.classList.toggle("hidden", signedIn);
    }
    presetBtns.forEach(btn => {
      const baseLabel = btn.getAttribute("data-preset-label") || btn.textContent || "";
      btn.textContent = signedIn ? baseLabel : `🔒 ${baseLabel}`;
    });

    soundRows.forEach(row => {
      const id = row.getAttribute("data-sound-id") || "";
      const allowed = canAccessSound(id, signedIn);
      const label = row.querySelector<HTMLElement>(".sound-value-label");
      const slider = row.querySelector<HTMLInputElement>(".sound-slider");
      if (!allowed) {
        row.classList.add("opacity-65", "cursor-pointer");
        row.setAttribute("data-locked", "true");
        if (label) {
          label.textContent = "🔒 Locked";
          label.className = "sound-value-label text-[9px] font-semibold text-amber-300/90 bg-amber-500/10 border border-amber-500/25 px-1.5 py-0.5 rounded shrink-0";
        }
        if (slider) {
          slider.value = "0";
        }
        if (audioStates[id]?.isPlaying) {
          updateSound(id, 0);
        }
      } else {
        row.classList.remove("opacity-65", "cursor-pointer");
        row.removeAttribute("data-locked");
        const state = audioStates[id];
        if (label) {
          label.className = "sound-value-label text-[10px] font-mono text-ink-subtle shrink-0";
          label.textContent = `${Math.round((state?.volume || 0) * 100)}%`;
        }
      }
    });
  }

  soundRows.forEach(row => {
    row.addEventListener("click", (e) => {
      const id = row.getAttribute("data-sound-id") || "";
      if (!canAccessSound(id, isUserSignedIn())) {
        e.preventDefault();
        e.stopPropagation();
        promptSoundSignIn();
      }
    });
  });

  catTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      catTabs.forEach(t => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-surface-2", "text-ink-subtle");
      });
      tab.classList.add("bg-primary", "text-white");
      tab.classList.remove("bg-surface-2", "text-ink-subtle");
      const cat = tab.getAttribute("data-sound-category") || "All";
      soundRows.forEach(row => {
        const rowCat = row.getAttribute("data-sound-category") || "";
        row.classList.toggle("hidden", cat !== "All" && rowCat !== cat);
      });
    });
  });

  soundSliders.forEach(slider => {
    slider.addEventListener("input", (e) => {
      const id = slider.getAttribute("data-sound-id") || "";
      if (!canAccessSound(id, isUserSignedIn())) {
        slider.value = "0";
        promptSoundSignIn();
        return;
      }
      const val = parseInt((e.target as HTMLInputElement).value);
      updateSound(id, val);
    });
  });

  toggleBtns.forEach(btn => {
    btn.addEventListener("click", (e) => {
      const id = btn.getAttribute("data-sound-id") || "";
      if (!canAccessSound(id, isUserSignedIn())) {
        e.stopPropagation();
        promptSoundSignIn();
        return;
      }
      const state = audioStates[id];
      if (state) updateSound(id, state.isPlaying ? 0 : 50);
    });
  });

  function updateSound(soundId: string, volume: number) {
    const state = audioStates[soundId];
    if (!state) return;
    if (!canAccessSound(soundId, isUserSignedIn()) && volume > 0) return;

    state.volume = volume / 100;
    const slider = widget?.querySelector(`.sound-slider[data-sound-id="${soundId}"]`) as HTMLInputElement;
    if (slider) slider.value = volume.toString();
    const label = widget?.querySelector(`[data-sound-id="${soundId}"] .sound-value-label`);
    if (label && canAccessSound(soundId, isUserSignedIn())) {
      label.textContent = `${volume}%`;
    }
    const btn = widget?.querySelector(`.sound-toggle-btn[data-sound-id="${soundId}"]`) as HTMLButtonElement;
    if (volume > 0) {
      state.isPlaying = true;
      btn?.classList.add("bg-primary/20", "border", "border-primary/50");
      if (!isMuted) {
        state.audio.volume = state.volume;
        if (state.audio.paused) state.audio.play().catch(() => {});
      }
    } else {
      state.isPlaying = false;
      btn?.classList.remove("bg-primary/20", "border", "border-primary/50");
      state.audio.volume = 0;
      state.audio.pause();
    }
  }

  function stopAllAndApply(presets: Record<string, number>) {
    const signedIn = isUserSignedIn();
    const hasLocked = Object.keys(presets).some((id) => !canAccessSound(id, signedIn));
    if (hasLocked) {
      promptSoundSignIn();
      return;
    }
    Object.keys(audioStates).forEach(id => updateSound(id, 0));
    Object.keys(presets).forEach(id => updateSound(id, presets[id]));
  }

  muteBtn?.addEventListener("click", () => {
    isMuted = !isMuted;
    Object.keys(audioStates).forEach(id => {
      if (isMuted) { audioStates[id].audio.volume = 0; }
      else if (audioStates[id].isPlaying) {
        audioStates[id].audio.volume = audioStates[id].volume;
        audioStates[id].audio.play().catch(() => {});
      }
    });
    if (muteText) muteText.textContent = isMuted ? "Unmute" : "Mute All";
    if (muteIcon) {
      muteIcon.innerHTML = isMuted
        ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />`
        : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />`;
    }
  });

  stopBtn?.addEventListener("click", () => Object.keys(audioStates).forEach(id => updateSound(id, 0)));

  document.getElementById("preset-study")?.addEventListener("click", () => stopAllAndApply({ lofi: 40, keyboard: 50, "brown-noise": 15 }));
  document.getElementById("preset-rain")?.addEventListener("click", () => stopAllAndApply({ rain: 60, thunder: 30, lofi: 20 }));
  document.getElementById("preset-cafe")?.addEventListener("click", () => stopAllAndApply({ cafe: 60, keyboard: 20, lofi: 10 }));
  document.getElementById("preset-piano")?.addEventListener("click", () => stopAllAndApply({ piano: 65, rain: 25 }));
  document.getElementById("preset-ocean")?.addEventListener("click", () => stopAllAndApply({ ocean: 65, wind: 30 }));
  document.getElementById("preset-reset")?.addEventListener("click", () => Object.keys(audioStates).forEach(id => updateSound(id, 0)));

  document.addEventListener("change-space", (e: any) => {
    const presets = e.detail?.presets;
    if (presets && isUserSignedIn()) stopAllAndApply(presets);
  });

  document.addEventListener("auth-state-changed", () => {
    syncSoundLocks();
  });
  syncSoundLocks();
</script>
